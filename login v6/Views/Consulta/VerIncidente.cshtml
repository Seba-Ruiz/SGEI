@model List<Model.incidente>
@{
    ViewBag.Title = "Ver Incidente";
}

<h4 class="page-title">Incidentes</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Incicentes de la Impresora") </li>
</ol>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>INCIDENTE</th>
                <th>FECHA DE INCIDENTE</th>
                <th>ACCION REALIZADA</th>
                <th>FECHA DE ACCION</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.incidente1</td>
                    <td>@a.fecha_incidente</td>
                    <td>@a.accion</td>
                    <td>@a.fecha_accion</td>

                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion sgei-accion-info" title="Ver imagen del incidente" aria-label="Ver imagen del incidente" href="~/consulta/VerImagen/@a.id"><i class="bi bi-image" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>

    </table>
    </div>

