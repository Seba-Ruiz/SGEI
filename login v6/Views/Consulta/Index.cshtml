
@{
    ViewBag.Title = "Index";
}

<h4 class="page-title">Consultas!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Consulta de insumos e incidentes de Impresoras.") </li>
</ol>

<div class="row">
    <div class="col-sm-2"></div>
    <div class="col-lg-8">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link active" href="#home-2" data-bs-toggle="tab" aria-expanded="false">
                    <span class="d-sm-none"><i class="bi bi-house"></i></span>
                    <span class="d-none d-sm-block">Insumos por Fecha</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#profile-2" data-bs-toggle="tab" aria-expanded="false">
                    <span class="d-sm-none"><i class="bi bi-person"></i></span>
                    <span class="d-none d-sm-block">Insumos Disponibles</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#messages-2" data-bs-toggle="tab" aria-expanded="true">
                    <span class="d-sm-none"><i class="bi bi-envelope"></i></span>
                    <span class="d-none d-sm-block">Incidendes de Impresora</span>
                </a>
            </li>
            
        </ul>
        <div class="tab-content">
            <div class="tab-pane active" id="home-2">
                @using (Html.BeginForm("Buscar", "Consulta", FormMethod.Post, new { id = "frm-incidente" }))

                {
                    @Html.AntiForgeryToken()
                <div class="row">
                    <div class="col-sm-12">
                        <div class="card card-acento-primary">
                            <div class="card-header">
                                <h4 class="card-title mb-0">CONSULTA DE INSUMO POR FECHA</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-12">
                                        @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                                        <p class="text-muted mb-4 font-13">
                                            Seleccione la ubicación de la impresora que desea consultar sus insumos. El sistema mostrará las impresoras de esa ubicación.
                                        </p>
                                        <div class="mb-3 text-center">
                                            @Html.Label("Nombre de Ubicacion")
                                            @Html.DropDownList("ubicacion", new SelectList(ViewBag.ubicaciones, "id", "nombreUbicacion"), new { @class = "form-control offset-lg-3", @style = "width:300px;" })
                                        </div>


                                        <div class="text-center">
                                            <button type="submit" class="btn btn-primary">Buscar</button>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                        }
             </div>
            <div class="tab-pane" id="profile-2">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="card card-acento-danger">
                            <div class="card-header">
                                <h4 class="card-title mb-0">CONSULTA DE INSUMO DISPONIBLES</h4>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-4 font-13">
                                    A continuación se muestra la cantidad de insumos que se dispone.
                                </p>
                                <div class="card-box table-responsive">
                                    <table class="table table-striped m-0">
                                        <thead>
                                            <tr>
                                                <th style="width:100px;">Nombre Insumo</th>
                                                <th style="width:100px;">Cantidad Disponible</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var a in ViewBag.insumos)

                                            {
                                                <tr>
                                                    <th>@a.nombre</th>
                                                    <th>@a.cantidad</th>

                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane" id="messages-2">
                @using (Html.BeginForm("BuscarIncidente", "Consulta", FormMethod.Post))

                {
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="card card-acento-warning">
                                <div class="card-header">
                                    <h4 class="card-title mb-0">CONSULTA DE INCIDENTES</h4>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-sm-12">
                                            @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                                            <p class="text-muted mb-4 font-13">
                                                Seleccione la ubicación de la impresora que desea consultar sus incidentes. El sistema mostrará las impresoras de esa ubicación.
                                            </p>
                                            <div class="mb-3 text-center">
                                                @Html.Label("Nombre de Ubicacion")
                                                @Html.DropDownList("ubicacion", new SelectList(ViewBag.ubicaciones, "id", "nombreUbicacion"), new { @class = "form-control offset-lg-3", @style = "width:300px;" })
                                            </div>


                                            <div class="text-center">
                                                <button type="submit" class="btn btn-primary">Buscar</button>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                }
            </div>

                </div>
    </div>
</div>


