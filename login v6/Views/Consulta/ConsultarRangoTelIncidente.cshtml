@model IEnumerable<Negocio.DTO.DTO_consulta_tel_incidente>
@{
    ViewBag.Title = "Consultar Rango";
}

<h4 class="page-title">Consulta insumos PC!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de la Consuta") </li>
</ol>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>FECHA INCIDENTE</th>
                <th>FECHA REPARACION</th>
                <th>INCIDENTE</th>
                <th>REPARACION</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.fecha_incidente</td>
                    <td>@a.fecha_reparacion</td>
                    <td>@a.nombre_incidente</td>
                    <td>@a.reparacion</td>
                </tr>
            }
        </tbody>

    </table>
</div>
