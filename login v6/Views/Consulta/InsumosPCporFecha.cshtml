@model IEnumerable<Negocio.DTO.DTO_u_computadora>
@{
    ViewBag.Title = "Insumos por Fecha";
}


<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de la Consulta") </li>
</ol>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>NOMBRE PC</th>
                <th>Nº IP</th>
                <th>DESCRIPCION</th>
                <th>FECHA UBICACION</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.nombre</td>
                    <td>@a.ip</td>
                    <td>@a.descripcion</td>
                    <td>@a.fecha_ubicacion</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion sgei-accion-info" title="Seleccionar Rango de Fechas" href="~/Consulta/ConsultarRangoFechaPC/@a.id_detalle" aria-label="Seleccionar Rango de Fechas"><i class="bi bi-calendar-range" aria-hidden="true"></i></a>
                        </div>
                    </td>
                    
                </tr>
            }
        </tbody>

    </table>
</div>
