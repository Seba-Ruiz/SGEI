@model IEnumerable<Negocio.DTO.DTO_u_camara_01>
@{
    ViewBag.Title = "Buscar";
}

<h4 class="page-title">Consulta de Insumos por Fecha!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de la consulta") </li>
</ol>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>MARCA_MODELO</th>
                <th>DESCRIPCION</th>
                <th>Nº IP</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.mmarca</td>
                    <td>@a.descripcion</td>
                    <td>@a.nro_ip</td>

                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion sgei-accion-info" title="Seleccionar rango fechas" href="~/consulta/ConsultarFechaCam/@a.id_camara" aria-label="Seleccionar rango fechas"><i class="bi bi-calendar-range" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>
