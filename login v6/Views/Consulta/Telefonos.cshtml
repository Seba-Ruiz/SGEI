
@{
    ViewBag.Title = "Consulta de Telefonos";
}

<h4 class="page-title">Consultas!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Consulta de Telefonos") </li>
</ol>

<div class="row">
    <div class="col-sm-2"></div>
    <div class="col-lg-8">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link active" href="#home-2" data-bs-toggle="tab" aria-expanded="false">
                    <span class="d-sm-none"><i class="bi bi-house"></i></span>
                    <span class="d-none d-sm-block">Telefonos Disponibles</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#profile-2" data-bs-toggle="tab" aria-expanded="false">
                    <span class="d-sm-none"><i class="bi bi-person"></i></span>
                    <span class="d-none d-sm-block">Incidentes de Telefonos</span>
                </a>
            </li>


        </ul>
        <div class="tab-content">
            <div class="tab-pane active" id="home-2">


                <div class="row">
                    <div class="col-sm-12">
                        <div class="card card-acento-primary">
                            <div class="card-header">
                                <h4 class="card-title mb-0">TELEFONOS DISPONIBLES</h4>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-4 font-13">
                                    A continuación se muestra la cantidad de telefonos que se dispone.
                                </p>
                                <div class="card-box table-responsive">
                                    <table class="table table-striped m-0">
                                        <thead>
                                            <tr>
                                                <th style="width:100px;">Descripción</th>
                                                <th style="width:100px;">Cantidad Disponible</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var a in ViewBag.telefonos)

                                            {
                                                <tr>
                                                    <th>@a.descripcion</th>
                                                    <th>@a.cantidad</th>

                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane" id="profile-2">

                <div class="row">
                    <div class="col-sm-12">
                        <div class="card card-acento-warning">
                            <div class="card-header">
                                <h4 class="card-title mb-0">CONSULTA DE INCIDENTES</h4>
                            </div>
                            <div class="card-body">


                                <div class="row">
                                    <div class="col-sm-12">
                                        @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                                        <p class="text-muted mb-4 font-13">
                                            Para comenzar seleccione en el combo la ubicación del telefono, el sistema mostrará los telefonos en esa ubicación.
                                        </p>
                                        @using (Html.BeginForm("BuscarTel", "Consulta", FormMethod.Post, new { id = "frm-incidente" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <div class="mb-3 text-center">
                                                @Html.Label("Nombre de Ubicacion:")
                                                @Html.DropDownList("ubicaciontel", new SelectList(ViewBag.ubicaciontel, "id_ubicacion_tel", "nombre_ubi"), new { @class = "form-select", @style = "width:200px;" })
                                            </div>
                                            <div class="mb-3">
                                                <div class="text-center">
                                                    <button type="submit" class="btn btn-primary">Buscar</button>
                                                </div>
                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>








                @*<div class="row">
            <div class="col-sm-3"></div>
            <div class="col-sm-12">
                <div class="card-box">
