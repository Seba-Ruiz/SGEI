@model List<Model.telefono>
@{
    ViewBag.Title = "Telefonos de Baja";
}

<h4 class="page-title">Impresoras!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de telefonos que se dieron de baja") </li>
</ol>
<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>Nº TELEFONO</th>
                <th>FECHA BAJA</th>
                <th>DESCRIPCION</th>
                
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.id_telefono</td>
                    <td>@a.fecha_baja</td>
                    <td>@a.descripcion</td>
                    
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion sgei-accion-exito" data-confirmar="¿Desea dar de ALTA este telefono?" title="Dar de alta nuevamente" href="~/Telefono/AltaTel/@a.id_telefono" aria-label="Dar de alta nuevamente"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>
