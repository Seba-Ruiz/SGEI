@model IEnumerable<Negocio.DTO.DTO_u_impresora_01>
@{
    ViewBag.Title = "Buscar Incidente";
}


<h4 class="page-title">Consultar Incidentes</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Seleccion de Impresora") </li>
</ol>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>MARCA_MODELO</th>
                <th>DESCRIPCION</th>
                <th>Nº IP</th>
                <th>PC_CONECTADA</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.marca_modelo</td>
                    <td>@a.descripcion</td>
                    <td>@a.ip</td>
                    <td>@a.pc_dondeseconecta</td>

                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion sgei-accion-info" title="Ver incidentes" aria-label="Ver incidentes" href="~/consulta/VerIncidente/@a.id"><i class="bi bi-list-ul" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>

    </table>
    </div>
