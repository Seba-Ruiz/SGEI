@model List<Model.pc>

<h4 class="page-title">Consulta!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Pcs De Baja") </li>
</ol>
@{
    ViewBag.Title = "Buscar";
}


<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>NOMBRE PC</th>
                <th>ULTIMA IP</th>
                <th>DESCRIPCION</th>
                <th>FECHA BAJA</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.nombre</td>
                    <td>@a.ip</td>
                    <td>@a.descripcion</td>
                    <td>@a.fecha_baja</td>


                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion sgei-accion-exito" data-confirmar="¿Desea dar de ALTA esta computadora?" title="Dar de alta nuevamente" href="~/Consulta/AltaPc/@a.id_pc" aria-label="Dar de alta nuevamente"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i></a>
                            <a class="js-ver-motivo sgei-accion sgei-accion-info" href="#" title="Ver motivo de baja" data-url="@Url.Action("VerMotivo", "Consulta", new { id = a.id_pc })" aria-label="Ver motivo de baja"><i class="bi bi-chat-left-text" aria-hidden="true"></i></a>
                        </div>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="motivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="resultado"></div>
    </div>
</div>


@section Scripts {
}
