@model List<Model.pc>

<h4 class="page-title">Consulta!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Pcs De Baja") </li>
</ol>
@{
    ViewBag.Title = "Buscar";
}


<div class="card-box table-responsive">
    <table class="table table-striped m-0">
        <thead>
            <tr>
                <th style="width:200px;">NOMBRE PC</th>
                <th style="width:150px;">ULTIMA IP</th>
                <th style="width:220px;">DESCRIPCION</th>
                <th style="width:200px;">FECHA BAJA</th>
                @*<th style="width:200px;">id</th>*@

                <th style="width:30px;"></th>
                <th style="width:30px;"></th>
                <th style="width:30px;"></th>
                <th style="width:30px;"></th>
                <th style="width:30px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <th>@a.nombre</th>
                    <th>@a.ip</th>
                    <th>@a.descripcion</th>
                    <th>@a.fecha_baja</th>


                    <th>
                        <a data-confirmar="¿Desea dar de ALTA esta computadora?" title="Dar de alta nuevamente" class="bi bi-upload" href="~/Consulta/AltaPc/@a.id_pc"></a>
                    </th>
                    <th>
                        <a href="#" title="Ver motivo de baja" data-url="@Url.Action("VerMotivo", "Consulta", new { id = a.id_pc })" class="js-ver-motivo bi bi-search"></a>

                    </th>

                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="motivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="resultado"></div>
    </div>
</div>


@section Scripts {
}
