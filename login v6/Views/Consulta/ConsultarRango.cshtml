@model IEnumerable<Negocio.DTO.DTO_consulta_01a>
@{
    ViewBag.Title = "ConsultarRango";
}

<h4 class="page-title">Consulta!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de la Consuta") </li>
</ol>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>FECHA CAMBIO INSUMO</th>
                <th>NOMBRE INSUMO</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.fechacambioinsumo</td>
                    <td>@a.nombre</td>
                </tr>
            }
        </tbody>

    </table>
    </div>
