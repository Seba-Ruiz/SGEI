@model IEnumerable<Negocio.DTO.DTO_u_telefono_01>
@{
    ViewBag.Title = "Buscar";
}


<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de la Consulta") </li>
</ol>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>NRO INTERNO</th>
                <th>DESCRIPCION</th>
                <th>MODELO</th>
                <th>TIPO TELEFONO</th>
                <th>UBICACION</th>
                <th>FECHA UBICACION</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.nro_interno</td>
                    <td>@a.descripcion</td>
                    <td>@a.mmarca</td>
                    <td>@a.nombre_tipo</td>
                    <td>@a.nombre_ubi</td>
                    <td>@a.fecha_ubicacion</td>
                    
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion sgei-accion-info" data-confirmar="¿Desea consultar incidentes de este telefono?" title="Consultar incidente" href="~/Consulta/ConsultarRangoFechaTelIncidente/@a.id_detalle" aria-label="Consultar incidente"><i class="bi bi-calendar-range" aria-hidden="true"></i></a>
                        </div>
                    </td>
                    
                </tr>
            }
        </tbody>

    </table>
</div>
