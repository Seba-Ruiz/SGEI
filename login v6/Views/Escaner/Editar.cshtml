
@model Negocio.DTO.DTO_u_detalle_escaner
@{
    ViewBag.Title = "Editar Escaner";
}
<h2>Editar Camara</h2>
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <div class="card-box">
            <h4 class="mt-0 header-title"><b>EDITAR ESCANER</b></h4>
            <p class="text-muted mb-4 font-13">
                Use este wizard para editar el escaner seleccionado, recuerde que una vez editada podrá consultar el detalle de dicha camara a travez de la busqueda de la misma como asi tambien volverla a editar.
            </p>

            @using (Html.BeginForm("GuardarES", "Escaner", FormMethod.Post, new { id = "basic-form", data_wizard = "edicion" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.id_escaner)
                @Html.HiddenFor(x => x.id_detalle)
                @Html.HiddenFor(x => x.fecha_ubicacion)
                <div>
                    <h3>Camara</h3>
                    <section>

                        <div class="mb-3 clearfix">
                            @Html.Label("Seleccione el Modelo del escaner")
                            @Html.DropDownListFor(x => x.id_mm, ViewBag.modelo as SelectList, new { @class = "form-select", @style = "width:250px;" })
                        </div>
                        <div class="mb-3 clearfix">
                            @Html.Label("Seleccione la ubicacion del escaner")
                            @Html.DropDownListFor(x => x.id_ubicacion_escaner, ViewBag.ubicacion as SelectList, new { @class = "form-select", @style = "width:250px;", @disabled = "" })
                            <span class="form-text"><small>La ubicación se actualizará al mover el equipo de una ubicación a otra.</small></span>
                        </div>
                    </section>
                    <h3>Detalle</h3>
                    <section>
                        <div class="mb-3 clearfix">
                            <div class="mb-3 clearfix">
                                @Html.Label("Ingrese descripcion del escaner")
                                @Html.TextBoxFor(x => x.descripcion, new { @class = "form-control", @style = "width:250px;", @required = "required" })
                                @Html.ValidationMessageFor(x => x.descripcion, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="mb-3 clearfix">
                            @Html.Label("Ingrese numero de IP del escaner")
                            @Html.TextBoxFor(x => x.nro_ip, new { @class = "form-control", @style = "width:250px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.nro_ip, null, new { @class = "text-danger small" })
                        </div>
                    </section>
                    <h3>Finalizar</h3>
                    <section>
                        @* Resumen de lo cargado (o de los cambios, en una edición): lo arma Scripts/app/sgei.js. *@
                        <div data-wizard-resumen></div>
                    </section>
                </div>

            }
            @*</form>*@
        </div>
    </div>
    <div class="col-md-2"></div>
</div>
