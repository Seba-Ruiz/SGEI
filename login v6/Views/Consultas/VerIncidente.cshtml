@model Negocio.DTO.DTO_IncidenteDetalle
@using Negocio.DTO
@using Negocio.Servicio
@{
    ViewBag.Title = "Detalle del incidente";
    var i = Model.Incidente;
    var fotos = (List<int>)ViewBag.Fotos;
    var usuarioId = (string)ViewBag.UsuarioId;
    var error = TempData["incidente.error"] as string;
    var borrador = TempData["incidente.borrador"] as string;
    Func<DateTime?, string> fecha = d => d.HasValue ? d.Value.ToString("dd/MM/yyyy") : "—";
    Func<DateTime, string> cuando = d => d.ToString("dd/MM/yyyy HH:mm");
    var observaciones = Model.CantidadObservaciones;
}

@helper Evento(DTO_TicketActividad a)
{
    switch (a.Campo)
    {
        case "ALTA":
            <text>cargó el incidente <strong>«@a.Nuevo»</strong></text>
            break;
        case "TICKET":
            <text>lo generó automáticamente desde el ticket <strong>@a.Nuevo</strong></text>
            break;
        case "EQUIPO":
            <text>cambió el equipo de <strong>@(a.Anterior ?? "ninguno")</strong> a <strong>@(a.Nuevo ?? "ninguno")</strong></text>
            break;
        case "INCIDENTE":
            <text>cambió el incidente de <strong>«@a.Anterior»</strong> a <strong>«@a.Nuevo»</strong></text>
            break;
        case "FECHA_INCIDENTE":
            <text>cambió la fecha del incidente de <strong>@(a.Anterior ?? "—")</strong> a <strong>@(a.Nuevo ?? "—")</strong></text>
            break;
        case "ACCION":
            <text>cambió la acción realizada de <strong>«@(a.Anterior ?? "—")»</strong> a <strong>«@(a.Nuevo ?? "—")»</strong></text>
            break;
        case "FECHA_ACCION":
            <text>cambió la fecha de la acción de <strong>@(a.Anterior ?? "—")</strong> a <strong>@(a.Nuevo ?? "—")</strong></text>
            break;
        case "FOTO":
            <text>@(a.Nuevo != null ? "agregó una foto" : "eliminó una foto")</text>
            break;
        default:
            <text>modificó @a.Campo</text>
            break;
    }
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Detalle del incidente</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item">Consultas</li>
            <li class="breadcrumb-item"><a href="~/Consultas/Incidentes">Incidentes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Detalle</li>
        </ol>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="~/Consultas/Incidentes" data-spinner><i class="bi bi-arrow-left me-1"></i>Volver</a>
        <a class="btn btn-primary" href="@Url.Action("EditarIncidente", new { tipo = i.Tipo, id = i.Id })" data-spinner><i class="bi bi-pencil me-1"></i>Editar</a>
    </div>
</div>

@if (error != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>@error</div>
}

<div class="row g-3">
    <div class="col-lg-5 order-lg-2">
        <div class="card sgei-form-card sgei-incidente-datos">
            <div class="card-header">
                <span class="sgei-form-card-icono"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
                <div class="min-w-0">
                    <h5 class="sgei-form-card-titulo">@i.Incidente</h5>
                    <p class="sgei-form-card-ayuda">@i.TipoNombre · @(i.Equipo ?? "Equipo sin datos")</p>
                </div>
            </div>
            <div class="card-body">
                <dl class="row sgei-detalle mb-0">
                    <dt class="col-sm-5">Tipo de equipo</dt>
                    <dd class="col-sm-7">@i.TipoNombre</dd>
                    <dt class="col-sm-5">Equipo</dt>
                    <dd class="col-sm-7">@(i.Equipo ?? "—")</dd>
                    <dt class="col-sm-5">@(i.Tipo == TiposEquipo.Telefono ? "Interno" : "IP")</dt>
                    <dd class="col-sm-7">@(i.Ip ?? "—")</dd>
                    <dt class="col-sm-5">Ubicación</dt>
                    <dd class="col-sm-7">@(i.Ubicacion ?? "—")</dd>
                    <dt class="col-sm-5">Incidente</dt>
                    <dd class="col-sm-7">@i.Incidente</dd>
                    <dt class="col-sm-5">Fecha del incidente</dt>
                    <dd class="col-sm-7">@fecha(i.FechaIncidente)</dd>
                    <dt class="col-sm-5">Acción realizada</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(i.Accion) ? "—" : i.Accion)</dd>
                    <dt class="col-sm-5">Fecha de la acción</dt>
                    <dd class="col-sm-7">@fecha(i.FechaAccion)</dd>
                    @if (Model.Tickets.Any())
                    {
                        <dt class="col-sm-5">Generado desde</dt>
                        <dd class="col-sm-7">
                            @foreach (var t in Model.Tickets)
                            {
                                <a class="d-block" href="@Url.Action("Ver", "Tickets", new { id = t.Id })" data-spinner><i class="bi bi-kanban me-1" aria-hidden="true"></i>Ticket #@t.Id · @t.Texto</a>
                            }
                        </dd>
                    }
                </dl>

                @if (i.Tipo == TiposEquipo.Impresora)
                {
                    <h6 class="mt-4 mb-2">Fotos</h6>
                    if (fotos.Count == 0)
                    {
                        <p class="text-muted small mb-0">Sin fotos. Podés agregar una desde <strong>Editar</strong>.</p>
                    }
                    else
                    {
                        <div class="sgei-fotos">
                            @foreach (var f in fotos)
                            {
                                <figure class="sgei-foto">
                                    <a href="@Url.Action("Foto", new { id = f })" target="_blank" rel="noopener" title="Ver en tamaño completo">
                                        <img src="@Url.Action("Foto", new { id = f })" alt="Foto del incidente" loading="lazy" />
                                    </a>
                                    @Html.BotonEliminar(Url.Action("EliminarFoto", new { id = f }), "¿Eliminar esta foto?")
                                </figure>
                            }
                        </div>
                    }
                }
            </div>
            <div class="card-footer">
                @Html.BotonEliminar(Url.Action("EliminarIncidente", new { tipo = i.Tipo, id = i.Id }), "¿Eliminar este incidente con sus observaciones e historial?")
            </div>
        </div>
    </div>

    <div class="col-lg-7 order-lg-1">
        <div class="card" id="actividad">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                <h5 class="mb-0 fs-6 fw-semibold">Observaciones e historial</h5>
                <span class="badge text-bg-light ms-auto">@observaciones @(observaciones == 1 ? "observación" : "observaciones")</span>
            </div>
            <div class="card-body">
                @if (!Model.Actividad.Any())
                {
                    <p class="text-muted small">
                        Todavía no hay observaciones. El historial de cambios empezó a registrarse con esta versión, así que
                        los incidentes anteriores no lo tienen.
                    </p>
                }
                <ol class="sgei-actividad">
                    @foreach (var a in Model.Actividad)
                    {
                        if (!a.EsComentario)
                        {
                            <li class="sgei-evento">
                                <i class="bi @(a.Campo == "ALTA" ? "bi-plus-circle" : a.Campo == "TICKET" ? "bi-kanban" : a.Campo == "FOTO" ? "bi-image" : "bi-pencil")" aria-hidden="true"></i>
                                <span><strong>@a.Usuario</strong> @Evento(a)</span>
                                <time datetime="@a.Fecha.ToString("s")">@cuando(a.Fecha)</time>
                            </li>
                            continue;
                        }
                        var propio = a.UsuarioId == usuarioId;
                        <li class="sgei-mensaje@(propio ? " sgei-mensaje-propio" : "")" id="observacion-@a.Id">
                            <span class="sgei-avatar" title="@a.Usuario" aria-hidden="true">@a.Iniciales</span>
                            <div class="sgei-mensaje-burbuja">
                                <div class="sgei-mensaje-cabecera">
                                    <strong>@a.Usuario</strong>
                                    <time datetime="@a.Fecha.ToString("s")">@cuando(a.Fecha)</time>
                                    @if (a.FechaEdicion.HasValue)
                                    {
                                        <span class="text-muted" title="Editada el @cuando(a.FechaEdicion.Value)">(editada)</span>
                                    }
                                    @if (propio)
                                    {
                                        <span class="sgei-mensaje-acciones">
                                            <button type="button" class="btn btn-link btn-sm p-0" data-editar-comentario="@a.Id"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Editar</button>
                                            @using (Html.BeginForm("EliminarObservacion", "Consultas", new { id = a.Id }, FormMethod.Post, new { @class = "d-inline", data_confirmar = "¿Eliminar tu observación? No se puede deshacer." }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-link btn-sm p-0 text-danger"><i class="bi bi-trash me-1" aria-hidden="true"></i>Eliminar</button>
                                            }
                                        </span>
                                    }
                                </div>
                                @* HTML saneado al guardar (Negocio/Servicio/HtmlSeguro.cs). *@
                                <div class="sgei-html" data-texto-comentario>@Html.Raw(a.Texto)</div>
                                @if (propio)
                                {
                                    using (Html.BeginForm("EditarObservacion", "Consultas", new { id = a.Id }, FormMethod.Post, new { @class = "sgei-mensaje-edicion", hidden = "hidden", data_edicion_comentario = a.Id }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <textarea name="texto" class="form-control" data-editor-alto="160" data-editor-requerido aria-label="Editar observación">@a.Texto</textarea>
                                        <div class="d-flex justify-content-end gap-2 mt-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-cancelar-edicion>Cancelar</button>
                                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Guardar</button>
                                        </div>
                                    }
                                }
                            </div>
                        </li>
                    }
                </ol>

                @using (Html.BeginForm("Observar", "Consultas", new { tipo = i.Tipo, id = i.Id }, FormMethod.Post, new { @class = "sgei-comentar", id = "formulario-observacion" }))
                {
                    @Html.AntiForgeryToken()
                    <label class="form-label fw-semibold" for="texto-observacion">Agregar una observación</label>
                    <textarea id="texto-observacion" name="texto" class="form-control" data-editor data-editor-alto="150" data-editor-requerido
                              placeholder="Qué se revisó, qué se cambió, qué falta…">@borrador</textarea>
                    <div class="d-flex justify-content-end mt-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1" aria-hidden="true"></i>Agregar observación</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section estilos {
    @Styles.Render("~/Content/summernote")
}
@section librerias {
    @Scripts.Render("~/bundles/summernote")
}
