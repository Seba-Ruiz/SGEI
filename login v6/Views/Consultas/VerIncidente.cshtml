@model Negocio.DTO.DTO_IncidenteFila
@using Negocio.Servicio
@{
    ViewBag.Title = "Detalle del incidente";
    var fotos = (List<int>)ViewBag.Fotos;
    Func<DateTime?, string> fecha = d => d.HasValue ? d.Value.ToString("dd/MM/yyyy") : "—";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Detalle del incidente</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
            <li class="breadcrumb-item">Consultas</li>
            <li class="breadcrumb-item"><a href="~/Consultas/Incidentes">Incidentes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Detalle</li>
        </ol>
    </div>
</div>

<div class="sgei-formulario">
    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">@Model.Incidente</h5>
                <p class="sgei-form-card-ayuda">@Model.TipoNombre · @(Model.Equipo ?? "Equipo sin datos")</p>
            </div>
        </div>
        <div class="card-body">
            <dl class="row sgei-detalle mb-0">
                <dt class="col-sm-4">Tipo de equipo</dt>
                <dd class="col-sm-8">@Model.TipoNombre</dd>
                <dt class="col-sm-4">Equipo</dt>
                <dd class="col-sm-8">@(Model.Equipo ?? "—")</dd>
                <dt class="col-sm-4">@(Model.Tipo == TiposEquipo.Telefono ? "Interno" : "IP")</dt>
                <dd class="col-sm-8">@(Model.Ip ?? "—")</dd>
                <dt class="col-sm-4">Ubicación</dt>
                <dd class="col-sm-8">@(Model.Ubicacion ?? "—")</dd>
                <dt class="col-sm-4">Incidente</dt>
                <dd class="col-sm-8">@Model.Incidente</dd>
                <dt class="col-sm-4">Fecha del incidente</dt>
                <dd class="col-sm-8">@fecha(Model.FechaIncidente)</dd>
                <dt class="col-sm-4">Acción realizada</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Accion) ? "—" : Model.Accion)</dd>
                <dt class="col-sm-4">Fecha de la acción</dt>
                <dd class="col-sm-8">@fecha(Model.FechaAccion)</dd>
            </dl>

            @if (Model.Tipo == TiposEquipo.Impresora)
            {
                <h6 class="mt-4 mb-2">Fotos</h6>
                if (fotos.Count == 0)
                {
                    <p class="text-muted small mb-0">Sin fotos. Podés agregar una desde <strong>Editar</strong>.</p>
                }
                else
                {
                    <div class="sgei-fotos">
                        @foreach (var f in fotos)
                        {
                            <figure class="sgei-foto">
                                <a href="@Url.Action("Foto", new { id = f })" target="_blank" rel="noopener" title="Ver en tamaño completo">
                                    <img src="@Url.Action("Foto", new { id = f })" alt="Foto del incidente" loading="lazy" />
                                </a>
                                @Html.BotonEliminar(Url.Action("EliminarFoto", new { id = f }), "¿Eliminar esta foto?")
                            </figure>
                        }
                    </div>
                }
            }
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary me-auto" href="~/Consultas/Incidentes"><i class="bi bi-arrow-left me-1"></i>Volver</a>
            @Html.BotonEliminar(Url.Action("EliminarIncidente", new { tipo = Model.Tipo, id = Model.Id }), "¿Eliminar este incidente?")
            <a class="btn btn-primary" href="@Url.Action("EditarIncidente", new { tipo = Model.Tipo, id = Model.Id })" data-spinner><i class="bi bi-pencil me-1"></i>Editar</a>
        </div>
    </div>
</div>
