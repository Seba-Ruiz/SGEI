@model Negocio.DTO.DTO_IncidenteFormulario
@using Negocio.Servicio
@{
    var editando = Model.Id != 0;
    var titulo = editando ? "Editar incidente" : "Nuevo incidente";
    ViewBag.Title = titulo;
    var fotos = (int)ViewBag.Fotos;
    Func<DateTime?, string> fecha = d => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : "";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">@titulo</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item">Consultas</li>
            <li class="breadcrumb-item"><a href="~/Consultas/Incidentes">Incidentes</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(editando ? "Editar" : "Nuevo")</li>
        </ol>
    </div>
</div>

@* Datos para Scripts/views/Consultas/FormularioIncidente.js: equipos y catálogo de incidentes de cada tipo. *@
<script type="application/json" id="datos-formulario">@Html.Raw(Json.Encode(ViewBag.Datos))</script>

@using (Html.BeginForm("GuardarIncidente", "Consultas", FormMethod.Post, new { @class = "sgei-formulario", enctype = "multipart/form-data", id = "formulario-incidente" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Id)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">@titulo</h5>
                <p class="sgei-form-card-ayuda">@(editando ? "Modificá los datos y presioná Guardar." : "Elegí el equipo, completá los datos y presioná Guardar.")</p>
            </div>
        </div>
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

            <div class="row g-3">
                <div class="col-sm-5">
                    <label class="form-label sgei-requerido" for="@(editando ? "TipoFijo" : "Tipo")">Tipo de equipo</label>
                    @if (editando)
                    {
                        @* Al editar no se cambia el tipo: cada tipo guarda sus incidentes en otra tabla. *@
                        @Html.HiddenFor(x => x.Tipo)
                        <select class="form-select" id="TipoFijo" disabled>
                            <option value="@Model.Tipo" selected>@TiposEquipo.Nombre(Model.Tipo)</option>
                        </select>
                    }
                    else
                    {
                        <select class="form-select" id="Tipo" name="Tipo" required>
                            @foreach (var t in TiposEquipo.Todos)
                            {
                                <option value="@t" @(t == Model.Tipo ? "selected" : "")>@TiposEquipo.Nombre(t)</option>
                            }
                        </select>
                    }
                </div>
                <div class="col-sm-7">
                    <label class="form-label sgei-requerido" for="EquipoId">Equipo</label>
                    <select class="form-select" id="EquipoId" name="EquipoId" required data-buscable data-valor="@Model.EquipoId">
                        <option value="">Elegí el equipo…</option>
                    </select>
                    @Html.ValidationMessageFor(x => x.EquipoId, null, new { @class = "text-danger small" })
                </div>

                @* Impresoras: el incidente se describe; el resto lo elige del catálogo (Gestión > Incidentes). *@
                <div class="col-12" data-solo-tipo="impresora">
                    <label class="form-label sgei-requerido" for="IncidenteTexto">Incidente</label>
                    @Html.TextBoxFor(x => x.IncidenteTexto, new { @class = "form-control", maxlength = TiposEquipo.LargoTexto, placeholder = "Ej.: Atasco de papel en la bandeja 2" })
                    @Html.ValidationMessageFor(x => x.IncidenteTexto, null, new { @class = "text-danger small" })
                </div>
                <div class="col-12" data-salvo-tipo="impresora">
                    <label class="form-label sgei-requerido" for="IncidenteId">Incidente</label>
                    <select class="form-select" id="IncidenteId" name="IncidenteId" data-buscable data-valor="@Model.IncidenteId">
                        <option value="">Elegí el incidente…</option>
                    </select>
                    <div class="form-text">Si no está en la lista, agregalo en <strong>Gestión</strong> &gt; Incidentes del equipo.</div>
                    @Html.ValidationMessageFor(x => x.IncidenteId, null, new { @class = "text-danger small" })
                </div>

                <div class="col-sm-6">
                    <label class="form-label sgei-requerido" for="FechaIncidente">Fecha del incidente</label>
                    <input type="date" class="form-control" id="FechaIncidente" name="FechaIncidente" value="@fecha(Model.FechaIncidente)" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    @Html.ValidationMessageFor(x => x.FechaIncidente, null, new { @class = "text-danger small" })
                </div>
                <div class="col-sm-6">
                    <label class="form-label sgei-requerido" for="FechaAccion">Fecha de la acción</label>
                    <input type="date" class="form-control" id="FechaAccion" name="FechaAccion" value="@fecha(Model.FechaAccion)" required />
                    @Html.ValidationMessageFor(x => x.FechaAccion, null, new { @class = "text-danger small" })
                </div>

                <div class="col-12">
                    <label class="form-label sgei-requerido" for="Accion">Acción realizada</label>
                    @Html.TextAreaFor(x => x.Accion, new { @class = "form-control", rows = 3, required = "required", maxlength = TiposEquipo.LargoAccion(Model.Tipo), placeholder = "Ej.: Se limpió el rodillo y se probó la impresión" })
                    @Html.ValidationMessageFor(x => x.Accion, null, new { @class = "text-danger small" })
                </div>

                <div class="col-12" data-solo-tipo="impresora">
                    <label class="form-label" for="foto">Foto <span class="text-muted fw-normal">(opcional)</span></label>
                    <input type="file" class="form-control" id="foto" name="foto" accept="image/*" />
                    <div class="form-text">
                        Hasta 5 MB.
                        @if (fotos > 0)
                        {
                            @:Este incidente ya tiene @fotos @(fotos == 1 ? "foto" : "fotos"); la que elijas se suma.
                        }
                    </div>
                    @Html.ValidationMessage("foto", null, new { @class = "text-danger small" })
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/Consultas/Incidentes">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
