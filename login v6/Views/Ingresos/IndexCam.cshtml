
@{
    ViewBag.Title = "Index";
}
@Html.AntiForgeryToken()
@Html.ValidationSummary("", new { @class = "text-danger" })
@using (Html.BeginForm("GuardarInsumoCam", "Ingresos", FormMethod.Post, new { id = "form-control" }))
{
    @Html.AntiForgeryToken()
    <div class="container">
        <!-- Page-Title -->
        <div class="row">
            <div class="col-sm-12">
                <h4 class="page-title">Nuevo ingreso</h4>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="~/inicio/index">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Nuevo ingreso de Insumos
                    </li>
                </ol>
            </div>
        </div>

        <div class="row">
            <div class="offset-sm-1 col-sm-10">
                <div class="card-box">
                    <div class="row g-3">
                        <div class="col-12">
                            <h3 class="h6 header-title mb-1">Ingreso de insumos de cámaras.</h3>
                                <p class="text-muted font-13 mb-2">
                                    Seleccione la cantidad que ingresa para cada tipo de insumo existente en el sistema para el tipo de equipo computadora.
                                </p>
                        </div>
                        @foreach (var item in ViewBag.insumocam)
                        {
                            <div class="col-md-6 col-sm-6 col-lg-4">
                                <div class="card sgei-insumo h-100 mb-0">
    <div class="card-body d-flex align-items-center gap-3">
        <div class="flex-grow-1">
            <div class="sgei-insumo-nombre">@item.nombre</div>
            <div class="small text-muted">Stock actual: <b class="text-body">@item.cantidad</b></div>
        </div>
        <a href="#" data-id="@item.id_insumo" class="js-agregar-ingreso btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Ingresar</a>
    </div>
</div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>


    <div class="modal fade" id="coso" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Número de comprobante</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 text-muted">
                Ingresá el número de orden de compra o numero de remito.
                <div class="mt-2">
                    <input type="number" name="od" class="form-control" value="0" style="width:200px;">
                    <input type="number" name="id" id="id" class="form-control" value="0" style="width:150px; display:none">
                </div>
            </div>
            <div class="mb-3 text-muted">
                Seleccioná el proveedor al que se le compró el insumo.
                <div class="mt-2">
                    @Html.DropDownList("id_proveedor", new SelectList(ViewBag.proveedor, "id", "nombre"), new { @class = "form-select", @style = "width:200px;" })

                </div>
            </div>
            <div class="mb-3 text-muted">
                Ingresá la cantidad.
                <div class="mt-2">
                    @Html.TextBox("cantidad", null, new { @class = "form-control", @style = "width:80px", @type = "number" })

                </div>
            </div>
                </div>
                <div class="modal-footer">
                    <a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Cerrar</a>
                <button type="submit" class="btn btn-primary">Aceptar</button>
                </div>
            </div>
        </div>
    </div>

}





