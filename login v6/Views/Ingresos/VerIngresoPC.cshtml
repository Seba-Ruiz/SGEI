@model List<Model.IngresoInsumo>
@{
    /**/

    ViewBag.Title = "Ingreso Computadora";
}
<h4 class="page-title">Insumos!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de ingreso de insumos de computadoras") </li>
</ol>


<div class="col-md-12">

    <div class="card-box">
        <table class="table table-hover sgei-grilla" data-grilla>
            <thead>
                <tr>
                    <th>TIPO EQUIPO</th>
                    <th>NOMBRE INSUMO</th>
                    <th>FECHA INGRESO</th>
                    <th>COMPROBANTE</th>
                    <th>PROVEEDOR</th>
                    <th>CANTIDAD</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                <tr>
                    <td>@a.tipo_equipo</td>
                    <td>@a.nombre_insumo</td>
                    <td>@a.fecha_ingreso</td>
                    <td>@a.nro_comprobante</td>
                    <td>@a.proveedor</td>
                    <td>@a.cantidad</td>

                </tr>
                }
            </tbody>

        </table>
    </div>
</div>
<div class="col-md-2"></div>




@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}