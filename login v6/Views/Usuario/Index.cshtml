@model List<Model.AspNetUsers>
@{
    /**/

    ViewBag.Title = "Usuarios";
}
<h4 class="page-title">Usuarios</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de Usuarios del sistema") </li>
</ol>

<div class="col-md-2"></div>
<div class="col-md-8">

    <div class="card-box">
        <table class="table table-hover sgei-grilla" data-grilla>
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Email Confirmado</th>
                    <th>Telefono</th>
                    <th>Fecha Baja</th>
                    <th class="sgei-col-acciones">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.Email</td>
                        @if (a.EmailConfirmed)
                        {
                            <td>Si</td>
                        }
                        else
                        {
                            <td>No</td>
                        }

                        <td>@a.PhoneNumber</td>
                        @if (a.fecha_baja == null)
                        {
                            <td>-</td>
                        }
                        else
                        {
                            <td>@a.fecha_baja</td>
                        }

                        <td>
                            <div class="sgei-acciones">
                                <a class="sgei-accion sgei-accion-info" title="Detalle" href="~/Usuario/Detalle/@a.Id" aria-label="Detalle"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                <a class="sgei-accion" title="Editar" href="~/Usuario/Editar/@a.Id" aria-label="Editar"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
<div class="col-md-2"></div>




@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}