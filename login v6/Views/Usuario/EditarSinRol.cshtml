@model Model.AspNetUsers
@{
    ViewBag.Title = "Editar Usuario";
}

<div class="container">

    <!-- Page-Title -->
    <div class="row">
        <div class="col-sm-12">

            <h4 class="page-title">Editar Usuario</h4>
            <ol class="breadcrumb">
                @*<li class="breadcrumb-item">
                        <a href="~/usuario/index">Usuario</a>
                    </li>*@
                <li class="breadcrumb-item active" aria-current="page">
                    Edite los datos de usuario.
                </li>
            </ol>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-2"></div>
            <div class="col-sm-8">
                <div class="card card-acento-primary">
                    <div class="card-header">
                        <h4 class="card-title mb-0">EDITAR USUARIO</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-12">
                                @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                                <p class="text-muted mb-4 font-13">
                                    Edite su usuario desde esta pantalla.
                                </p>
                                <div class="col-md-2"></div>
                                <div class="row">
                                    <div class="col-md-10">

                                        @using (Html.BeginForm("ConfirmarEditarSinRol", "Usuario", FormMethod.Post, new { id = "form-control" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(x => x.Id)


                                            <div class="mb-3">
                                                @Html.Label("Email del Usuario")
                                                @Html.TextBoxFor(x => x.Email, new { @class = "form-control", @style = "width:350px;", @required = "required", @disabled = "disabled" })
                                                @Html.ValidationMessageFor(x => x.Email, null, new { @class = "text-danger small" })

                                            </div>

                                            <div class="mb-3">
                                                @Html.Label("Teléfono")
                                                @Html.TextBoxFor(x => x.PhoneNumber, new { @class = "form-control", @style = "width:350px;", @required = "required" })
                                                @Html.ValidationMessageFor(x => x.PhoneNumber, null, new { @class = "text-danger small" })

                                            </div>


                                            <div class="mb-3">
                                                @Html.Label("Tipo Usuario")

                                                @Html.DropDownList("tipoRol", ViewBag.tipo as SelectList, new { @class = "form-select", @style = "width:350px;", @disabled = "disabled" })
                                                <span class="form-text"><small>El tipo de usuario es gestionado por el Administrador del sistema.</small></span>
                                                @*<input class="form-control" name="idusr" type="text" value=@ViewBag.tipoUsuario />*@
                                                @*@Html.DropDownList("tipoUsuario", ViewBag.tipo as SelectList, new { @class = "form-select", @style = "width:250px;" })*@
                                            </div>

                                            <div class="mb-3">
                                                @Html.Label("Nombre")
                                                @Html.TextBoxFor(x => x.nombre, new { @class = "form-control", @style = "width:350px;", @required = "required" })
                                                @Html.ValidationMessageFor(x => x.nombre, null, new { @class = "text-danger small" })
                                            </div>

                                            <div class="mb-3">
                                                @Html.Label("Apellido")
                                                @Html.TextBoxFor(x => x.apellido, new { @class = "form-control", @style = "width:350px;", @required = "required" })
                                                @Html.ValidationMessageFor(x => x.apellido, null, new { @class = "text-danger small" })
                                            </div>

                                            <div class="modal-footer">
                                                <button type="submit" class="btn btn-primary" title="Guardar"> Guardar </button>
                                            </div>
                                        }
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>




