@model Model.ubicacion_impresora
@{
    ViewBag.Title = "Alta";
}

<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/home">ALTA</a></li>
    <li class="breadcrumb-item active" aria-current="page">@(Model.id > 0 ? "Volver a dar de ALTA la impresora" : "Volver a dar de ALTA la impresora") </li>
</ol>

@using (Html.BeginForm("Alta_aceptada", "Home", FormMethod.Post, new { id = "frm-ubicacion" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(x => x.descripcion)
    @Html.HiddenFor(x => x.id)
    @Html.HiddenFor(x => x.impresora_id)
    <div class="row">
        <div class="col-sm-8 offset-sm-2">
            <div class="card card-acento-primary">
                <div class="card-header">
                    <h4 class="card-title mb-0">ALTA DE IMPRESORA</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            <p class="text-muted mb-4 font-13">
                                Ingrese la nueva ubicación de la impresora y la fecha que se colocó la misma.
                            </p>
                            <div class="mb-3 offset-lg-3">
                                @Html.Label("Nombre de Ubicacion")
                                @Html.DropDownListFor(x => x.ubicacion_id, new SelectList(ViewBag.ubicaciones, "id", "nombreUbicacion"), new { @class = "form-select", @style = "width:250px;" })
                                @Html.ValidationMessageFor(x => x.ubicacion_id, null, new { @class = "text-danger small" })
                            </div>

                            <div class="mb-3 offset-lg-3">
                                @Html.Label("Fecha de Ubicacion")
                                @Html.TextBoxFor(x => x.fecha_ubicacion, new { @class = "form-control", type = "date", @style = "width:250px;" })
                                @Html.ValidationMessageFor(x => x.fecha_ubicacion, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>
                        </div>
                    </div>
                </div>
    </div>

    

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>

}

