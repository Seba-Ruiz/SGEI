@model Negocio.DTO.DTO_es
@{
    ViewBag.Title = "Alta Escaner";
}

<h2>Alta de Escaner</h2>

<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <div class="card-box">
            <h4 class="mt-0 header-title"><b>ALTA DE ESCANER</b></h4>
            <p class="text-muted mb-4 font-13">
                Use este wizard para dar de alta un escaner, recuerde que una vez dado de alta podrá consultar el detalle de dicho escaner a travez de la busqueda del mismo como asi tambien editarlo.
            </p>
            @using (Html.BeginForm("GuardarES", "Home", FormMethod.Post, new { id = "basic-form", data_wizard = "alta" }))
            {
                @Html.AntiForgeryToken()
                <div>
                    <h3>Switch</h3>

                    <section>


                        <div class="mb-3 clearfix">
                            @Html.Label("Seleccione el Modelo del escaner")
                            @Html.DropDownListFor(x => x.mmarca, new SelectList(ViewBag.modelo, "id_marca_modelo_escaner", "descripcion"), new { @class = "form-select", @style = "width:250px;" })
                        </div>

                        <div class="mb-3 clearfix">
                            @Html.Label("Seleccione la ubicacion del escaner")
                            @Html.DropDownListFor(x => x.ubicacion, new SelectList(ViewBag.ubicacion, "id_ubicacion_escaner", "nombre"), new { @class = "form-select", @style = "width:250px;" })
                        </div>
                        
                    </section>

                    <h3>Detalle</h3>
                    <section>
                        <div class="mb-3 clearfix">

                            <div class="mb-3 clearfix">
                                @Html.Label("Ingrese descripcion del Escaner")
                                @Html.TextBoxFor(x => x.descripcion, new { @class = "form-control", @style = "width:250px;", @required = "required" })
                                @Html.ValidationMessageFor(x => x.descripcion, null, new { @class = "text-danger small" })

                            </div>
                        </div>
                        <div class="mb-3 clearfix">
                            @Html.Label("Ingrese numero de IP del Escaner")
                            @Html.TextBoxFor(x => x.ip, new { @class = "form-control", @style = "width:250px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.ip, null, new { @class = "text-danger small" })

                        </div>
                    </section>

                    <h3>Finalizar</h3>
                    <section>
                        @* Resumen de lo cargado (o de los cambios, en una edición): lo arma Scripts/app/sgei.js. *@
                        <div data-wizard-resumen></div>
                    </section>
                </div>

            }


        </div>
    </div>
    <div class="col-md-2"></div>
</div>
