
@{
    ViewBag.Title = "Mover";
}
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Mover de ubicacion la impresora") </li>
</ol>
@using (Html.BeginForm("Mover", "Home", FormMethod.Post, new { id = "frm-mover" }))
{
    @Html.AntiForgeryToken()


    <div class="row">
        <div class="col-sm-6 offset-sm-3">
            <div class="card card-acento-primary">
                <div class="card-header">
                    <h4 class="card-title mb-0">MOVER DE UBICACIÓN</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                            <p class="text-muted mb-4 font-13">
                                Mueve la impresora a otra ubicación. Seleccione la nueva ubicación para la impresora.
                            </p>
                            <div class="mb-3">
                                @Html.Label("Nombre de Ubicacion")
                                @Html.DropDownList("id_nueva_ubicacion", new SelectList(ViewBag.ubicacion, "id", "nombreUbicacion"), new { @class = "form-select", @style = "width:300px;" })
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-primary">Mover</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
}

