@model IEnumerable<Negocio.DTO.DTO_u_impresora_04>
@{
    ViewBag.Title = "impresoras_baja";
}

<h4 class="page-title">Impresoras!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de impresoras que se dieron de baja") </li>
</ol>
<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>MARCA_MODELO</th>
                <th>TIPO</th>
                <th>DESCRIPCION</th>
                <th>RESPONSABLE</th>
                <th>Nº IP</th>
                <th>PC_CONECTADA</th>
                <th>FECHA BAJA</th>
                <th>MOTIVO BAJA</th>
                <th>ULTIMA UBICACION</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.marca_modelo</td>
                    <td>@a.tipo</td>
                    <td>@a.descripcion</td>
                    <td>@a.responsable</td>
                    <td>@a.ip</td>
                    <td>@a.pc_dondeseconecta</td>
                    <td>@a.fecha_baja</td>
                    <td>@a.motivo_baja</td>
                    <td>@a.ultima_ubicacion</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion sgei-accion-exito" data-confirmar="¿Desea dar de ALTA esta impresora?" title="Dar de alta nuevamente" href="~/Home/Alta/@a.id" aria-label="Dar de alta nuevamente"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>
