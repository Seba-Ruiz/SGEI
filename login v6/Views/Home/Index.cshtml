@model IEnumerable<Negocio.DTO.DTO_u_impresora_01>
@{
    ViewBag.Title = "Impresoras";
}

<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
    <li class="breadcrumb-item active" aria-current="page">Impresoras</li>
</ol>

<div class="card-box">
    @* Combo de ubicación: Scripts/app/sgei.js lo ubica junto al buscador y filtra la columna Ubicación (data-filtro-grilla). *@
    <div class="sgei-grilla-filtro">
        <label class="visually-hidden" for="ubicacion">Ubicación</label>
        @Html.DropDownList("ubicacion", (SelectList)ViewBag.ubicaciones, "Todas las ubicaciones", new { @class = "form-select", autocomplete = "off", data_filtro_grilla = "#grilla-impresoras", data_filtro_columna = ".sgei-col-ubicacion", data_buscable = "" })
    </div>

    <table class="table table-hover sgei-grilla" data-grilla id="grilla-impresoras">
        <thead>
            <tr>
                <th>Nº IMP</th>
                <th>MARCA_MODELO</th>
                <th>TIPO</th>
                <th class="sgei-col-ubicacion">UBICACIÓN</th>
                <th>DESCRIPCION</th>
                <th>FECHA UBICACION</th>
                <th>RESPONSABLE</th>
                <th>Nº IP</th>
                <th>PC_CONECTADA</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
            <tr>
                <td>@a.id_imp</td>
                <td>@a.marca_modelo</td>
                <td>@a.tipo</td>
                <td>@a.ubicacion</td>
                <td>@a.descripcion</td>
                <td>@a.fecha_ubicacion</td>
                <td>@a.responsable</td>
                <td>@a.ip</td>
                <td>@a.pc_dondeseconecta</td>
                <td>
                    <div class="sgei-acciones">
                        <a class="sgei-accion" title="Editar" href="~/Impresora/Editar/@a.id" aria-label="Editar"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                        <a class="sgei-accion sgei-accion-neutro" data-confirmar="¿Desea mover de ubicacion esta impresora?" title="Mover a otra ubicacion la impresora" href="~/Home/BuscarParaMover/@a.id" aria-label="Mover a otra ubicacion la impresora"><i class="bi bi-arrows-move" aria-hidden="true"></i></a>
                        <a class="sgei-accion sgei-accion-peligro" data-confirmar="¿Desea dar de BAJA esta impresora?" title="Dar de baja a la impresora" href="~/Home/Baja/@a.id" aria-label="Dar de baja a la impresora"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i></a>
                    </div>
                </td>
            </tr>
            }
        </tbody>

    </table>
</div>
