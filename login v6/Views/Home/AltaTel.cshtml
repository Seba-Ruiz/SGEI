@model Negocio.DTO.DTO_Telefono
@{
    ViewBag.Title = "Alta Telefono";
}

<h2>Alta de Telefono</h2>

<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <div class="card-box">
            <h4 class="mt-0 header-title"><b>ALTA DE TELEFONO</b></h4>
            <p class="text-muted mb-4 font-13">
                Use este wizard para dar de alta un telefono, recuerde que una vez dado de alta podrá consultar el detalle de dicho telefono a travez de la busqueda del mismo como asi tambien editarlo.
            </p>
            @using (Html.BeginForm("GuardarTel", "Home", FormMethod.Post, new { id = "basic-form", data_wizard = "alta" }))
            {
                @Html.AntiForgeryToken()

                
                <div>
                    <h3>Telefono</h3>

                    <section>


                        <div class="mb-3 clearfix">
                            @Html.Label("Seleccione el Modelo del Telefono")
                            @Html.DropDownListFor(x => x.mmarca, new SelectList(ViewBag.modelo, "id_mm", "descripcion"), new { @class = "form-select", @style = "width:250px;" })
                        </div>
                        <div class="mb-3 clearfix">
                            @Html.Label("Seleccione el Tipo del Telefono")
                            @Html.DropDownListFor(x => x.tipo_tel, new SelectList(ViewBag.tipo, "id_tipo", "nombre_tipo"), new { @class = "form-select", @style = "width:250px;" })
                        </div>
                        <div class="mb-3 clearfix">
                            @Html.Label("Seleccione la ubicacion del Telefono")
                            @Html.DropDownListFor(x => x.ubicacion, new SelectList(ViewBag.ubicacion, "id_ubicacion_tel", "nombre_ubi"), new { @class = "form-select", @style = "width:250px;" })
                        </div>

                    </section>

                    <h3>Detalle</h3>
                    <section>
                        <div class="mb-3 clearfix">

                            <div class="mb-3 clearfix">
                                @Html.Label("Ingrese descripcion del Telefono")
                                @Html.TextBoxFor(x => x.descripcion, new { @class = "form-control", @style = "width:250px;", @required = "required", data_nombre_unico = "telefono", data_nombre_id = 0, data_nombre_url = Url.Action("NombreEquipo", "Validaciones") })
                                @Html.ValidationMessageFor(x => x.descripcion, null, new { @class = "text-danger small" })

                            </div>
                        </div>
                        <div class="mb-3 clearfix">
                            @Html.Label("Ingrese numero de Interno")
                            @Html.TextBoxFor(x => x.interno, new { @class = "form-control", @style = "width:250px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.interno, null, new { @class = "text-danger small" })

                        </div>
                    </section>
                    
                    <h3>Finalizar</h3>
                    <section>
                        @* Resumen de lo cargado (o de los cambios, en una edición): lo arma Scripts/app/sgei.js. *@
                        <div data-wizard-resumen></div>
                    </section>
                </div>

            }
           

        </div>
    </div>
    <div class="col-md-2"></div>
</div>
