@model Model.pc_insumo_pc
@{
    ViewBag.Title = "AgregarInsumo";
    Model.detalle_pc_id = ViewBag.id_detalle;
}


<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Cargar Insumo a Impresora") </li>
</ol>

@using (Html.BeginForm("Guardar_insumo_pc", "Insumo", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @*@Html.HiddenFor(x => x.id)*@
    @Html.HiddenFor(x => x.detalle_pc_id)
    
    
<div class="row">
    <div class="col-sm-6 offset-sm-3">
        <div class="card card-acento-primary">
            <div class="card-header">
                <h4 class="card-title mb-0">INSUMOS</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12">
                        @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                        <p class="text-muted mb-4 font-13">
                            Seleccione el insumo perteneciente a la computadora, el número de serie y la fecha de la colocación del insumo.
                        </p>
                        <div class="mb-3">
                            @Html.Label("Seleccione insumo")
                            @Html.DropDownListFor(x => x.insumo_id, new SelectList(ViewBag.insumos, "id_insumo", "nombre"), new { @class = "form-select", @style = "width:200px;" })
                        </div>
                        <div class="mb-3">
                            @Html.Label("Número de serie del insumo")
                            @Html.TextBoxFor(x => x.nro_serie, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.nro_serie, null, new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.Label("Fecha de colocación")
                            @Html.TextBoxFor(x => x.fecha_insumo, new { @class = "form-control", type = "date", @style = "width:200px;" })
                            @Html.ValidationMessageFor(x => x.fecha_insumo, null, new { @class = "text-danger small" })
                        </div>


                        <div class="text-center">
                            <button type="submit" class="btn btn-primary">Guardar</button>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    
