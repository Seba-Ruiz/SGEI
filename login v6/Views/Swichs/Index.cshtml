@model IEnumerable<Negocio.DTO.DTO_u_sw_01>
@{
    ViewBag.Title = "Switches";
}

<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
    <li class="breadcrumb-item active" aria-current="page">Switches</li>
</ol>

<div class="card-box">
    @* Combo de ubicación: Scripts/app/sgei.js lo ubica junto al buscador y filtra la columna Ubicación (data-filtro-grilla). *@
    <div class="sgei-grilla-filtro">
        <label class="visually-hidden" for="ubicacion">Ubicación</label>
        @Html.DropDownList("ubicacion", (SelectList)ViewBag.ubicaciones, "Todas las ubicaciones", new { @class = "form-select", autocomplete = "off", data_filtro_grilla = "#grilla-switches", data_filtro_columna = ".sgei-col-ubicacion", data_buscable = "" })
    </div>

    <table class="table table-hover sgei-grilla" data-grilla id="grilla-switches">
        <thead>
            <tr>
                <th>Nº sw</th>
                <th>NRO IP</th>
                <th>DESCRIPCION</th>
                <th>MODELO</th>
                <th>INTERFACES</th>
                <th class="sgei-col-ubicacion">UBICACIÓN</th>
                <th>FECHA UBICACION</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
            <tr>
                <td>@a.id_sw</td>
                <td><a href="http://@a.nro_ip" target="_blank" rel="noopener" class="text-danger">@a.nro_ip</a></td>
                <td>@a.descripcion</td>
                <td>@a.mmarca</td>
                <td>@a.interfaces</td>
                <td>@a.nombre_ubi</td>
                <td>@a.fecha_ubicacion</td>
                <td>
                    <div class="sgei-acciones">
                        <a class="sgei-accion" title="Editar" href="~/Swichs/Editar/@a.id_detalle" aria-label="Editar"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                        <a class="sgei-accion sgei-accion-peligro" data-confirmar="¿Desea dar de BAJA este switch?" title="Dar de baja" href="~/Swichs/Baja/@a.id_detalle" aria-label="Dar de baja"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i></a>
                    </div>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
