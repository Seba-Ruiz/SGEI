    else
    {*@
<div class="col-lg-10 offset-lg-1">
    <div class="card-box">
        <h4 class="text-danger header-title mt-0">Mantenimiento Sugerido</h4>
        <p class="text-muted mb-4 font-13">
            Las siguiente lista muestra las impresoras y computadoras que necesitan mantenimiento.
        </p>

        <div class="table-responsive">
            <table id="datatable" class="table table-striped toggle-circle mb-0">
                <thead>
                    <tr>

                        <th>Equipo</th>
                        <th>Último Mantenimietno</th>
                        <th>Ubicación</th>
                        <th>Descripción</th>
                        <th style="min-width: 80px;">Accion</th>
                    </tr>
                </thead>


                <tbody>
                    @foreach (var item in Model)
                    {
                        if (item.tipo == "PC")
                        {
                            <tr>
                                <td><img src="~/assets/images/products/macbook.jpg" class="thumb-sm float-start me-2" alt=""><a title="Detalles" href="~/Computadora/Detalle/@item.id" class="text-primary"><b>@item.nombre</b></a> </td>
                                <td><span class="text-danger">@item.ultimo_mantenimiento</span></td>
                                <td><span class="text-dark">@item.ubicacion</span></td>
                                <td><span class="text-dark">@item.descripcion</span></td>
                                <td>
                                    <a href="#" data-accion="mantenimiento-pc" data-id="@item.id" data-nombre="@item.nombre" title="Realizar Mantenimiento" class="js-sugerido table-action-btn"><i class="bi bi-check2-circle"></i></a>
                                    <a href="#" data-accion="posponer-pc" data-id="@item.id" data-nombre="@item.nombre" title="Posponer Mantenimiento" class="js-sugerido table-action-btn"><i class="bi bi-clock-history"></i></a>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td><img src="~/assets/images/products/hp.jpg" class="thumb-sm float-start me-2" alt=""><a title="Detalles" href="~/Impresora/Editar/@item.id" class="text-primary"><b>@item.nombre</b></a> </td>
                                <td><span class="text-danger">@item.ultimo_mantenimiento</span></td>
                                <td><span class="text-dark">@item.ubicacion</span></td>
                                <td><span class="text-dark">@item.descripcion</span></td>
                                <td>
                                    <a href="#" data-accion="mantenimiento-impresora" data-id="@item.id" data-nombre="@item.nombre" title="Realizar Mantenimiento" class="js-sugerido table-action-btn"><i class="bi bi-check2-circle"></i></a>
                                    <a href="#" data-accion="posponer-impresora" data-id="@item.id" data-nombre="@item.nombre" title="Posponer Mantenimiento" class="js-sugerido table-action-btn"><i class="bi bi-clock-history"></i></a>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

    </div>
</div>
@* } *@



@using (Html.BeginForm("PosponerMante", "Computadora", FormMethod.Post, new { id = "form-control" }))
{
    @Html.AntiForgeryToken()
    <div class="modal fade" id="coso" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Posponer Mantenimiento</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 text-muted">
                Ingresá la cantidad de dias que deseas posponer el mantenimiento de la computadora
                <label id="nombre_p"></label>
                <div class="mt-2">
                    <input type="number" name="dias" class="form-control" value="0" style="width:150px;">
                    <input type="number" name="id" id="id" class="form-control" value="0" style="width:150px; display:none">
                </div>
            </div>
                </div>
                <div class="modal-footer">
                    <a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Cerrar</a>
                <button type="submit" class="btn btn-primary">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
}
