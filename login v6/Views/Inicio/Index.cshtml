@using Negocio.Servicio
@{
    ViewBag.Title = "Dashboard";

    // Tarjetas del resumen: título, cantidad, ícono y pantalla a la que lleva.
    var equipos = new[]
    {
        new { Titulo = "Impresoras",   Cantidad = ViewBag.impresoras,   Icono = "bi-printer",     Url = Url.Content("~/Home/Index") },
        new { Titulo = "Computadoras", Cantidad = ViewBag.computadoras, Icono = "bi-pc-display",  Url = Url.Content("~/Computadora/Index") },
        new { Titulo = "Teléfonos",    Cantidad = ViewBag.telefonos,    Icono = "bi-telephone",   Url = Url.Content("~/Telefonos/Index") },
        new { Titulo = "Cámaras",      Cantidad = ViewBag.camaras,      Icono = "bi-camera-video", Url = Url.Content("~/Camara/Index") },
        new { Titulo = "Switches",     Cantidad = ViewBag.sw,           Icono = "bi-diagram-3",   Url = Url.Content("~/Swichs/Index") },
        new { Titulo = "Escáneres",    Cantidad = ViewBag.es,           Icono = "bi-upc-scan",    Url = Url.Content("~/Escaner/Index") }
    };

    // Gráficos: id, título, subtítulo, columnas y alto del lienzo. Los datos van en #datos-dashboard
    // y los dibuja Scripts/views/Inicio/Index.js.
    var graficos = new[]
    {
        new { Id = "incidentes", Titulo = "Incidentes por mes", Ayuda = "Últimos " + Dashboard.MesesIncidentes + " meses, por tipo de equipo", Columnas = "col-xl-8", Alto = 300, Link = Url.Action("Incidentes", "Consultas"), TextoLink = "Ver incidentes" },
        new { Id = "estados", Titulo = "Tickets por estado", Ayuda = "Abiertos y terminados en los últimos " + Tickets.DiasTerminadosEnBoard + " días", Columnas = "col-xl-4 col-md-6", Alto = 300, Link = Url.Action("Index", "Tickets"), TextoLink = "Ir al board" },
        new { Id = "usuarios", Titulo = "Tickets por usuario", Ayuda = "Asignados a cada persona, por estado", Columnas = "col-xl-7 col-md-6", Alto = 320, Link = Url.Action("Index", "Tickets"), TextoLink = "Ir al board" },
        new { Id = "sistemas", Titulo = "Computadoras por sistema operativo", Ayuda = "Computadoras activas, según su último detalle", Columnas = "col-xl-5", Alto = 320, Link = Url.Action("Index", "Computadora"), TextoLink = "Ver computadoras" }
    };
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Dashboard</h4>
        <p class="text-muted mb-0">Resumen del equipamiento, los incidentes y los tickets de SGEI.</p>
    </div>

    <div class="dropdown">
        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-tools me-1"></i> Mantenimiento preventivo
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="~/Computadora/Preventivo"><i class="bi bi-pc-display me-2"></i>Computadoras</a></li>
            <li><a class="dropdown-item" href="~/Impresora/Preventivo"><i class="bi bi-printer me-2"></i>Impresoras</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" href="~/Inicio/Sugeridos"><i class="bi bi-lightbulb me-2"></i>Sugeridos</a></li>
        </ul>
    </div>
</div>

<div class="row g-3">
    @foreach (var equipo in equipos)
    {
        <div class="col-6 col-md-4 col-xxl-2">
            <a class="card sgei-kpi h-100 mb-0" href="@equipo.Url" data-spinner>
                <div class="card-body">
                    <span class="sgei-kpi-icono"><i class="bi @equipo.Icono"></i></span>
                    <div class="sgei-kpi-valor">@equipo.Cantidad</div>
                    <div class="sgei-kpi-titulo">@equipo.Titulo</div>
                </div>
            </a>
        </div>
    }
</div>

<script type="application/json" id="datos-dashboard">@Html.Raw(Json.Encode(ViewBag.Graficos))</script>

<div class="row g-3 mt-1">
    @foreach (var g in graficos)
    {
        <div class="col-12 @g.Columnas">
            <section class="card sgei-grafico h-100 mb-0" aria-labelledby="titulo-@g.Id">
                <div class="card-body">
                    <header class="sgei-grafico-cabecera">
                        <div>
                            <h2 class="sgei-grafico-titulo" id="titulo-@g.Id">@g.Titulo</h2>
                            <p class="sgei-grafico-ayuda">@g.Ayuda · <span data-total="@g.Id"></span></p>
                        </div>
                        <a class="sgei-grafico-link" href="@g.Link" data-spinner>@g.TextoLink<i class="bi bi-arrow-right-short" aria-hidden="true"></i></a>
                    </header>
                    <div class="sgei-grafico-lienzo" style="height: @(g.Alto)px">
                        <canvas id="grafico-@g.Id" role="img" aria-label="@g.Titulo"></canvas>
                        <p class="sgei-grafico-vacio" data-vacio="@g.Id" hidden>Todavía no hay datos para mostrar.</p>
                    </div>
                    <details class="sgei-grafico-tabla">
                        <summary>Ver datos</summary>
                        <div class="table-responsive" data-tabla="@g.Id"></div>
                    </details>
                </div>
            </section>
        </div>
    }
</div>

@section librerias {
    @Scripts.Render("~/bundles/chartjs")
}
