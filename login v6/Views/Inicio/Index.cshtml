@{
    ViewBag.Title = "Inicio";

    // Tarjetas del resumen: título, cantidad, ícono y pantalla a la que lleva.
    var equipos = new[]
    {
        new { Titulo = "Impresoras",   Cantidad = ViewBag.impresoras,   Icono = "bi-printer",     Url = Url.Content("~/Home/Index") },
        new { Titulo = "Computadoras", Cantidad = ViewBag.computadoras, Icono = "bi-pc-display",  Url = Url.Content("~/Computadora/Index") },
        new { Titulo = "Teléfonos",    Cantidad = ViewBag.telefonos,    Icono = "bi-telephone",   Url = Url.Content("~/Telefonos/Index") },
        new { Titulo = "Cámaras",      Cantidad = ViewBag.camaras,      Icono = "bi-camera-video", Url = Url.Content("~/Camara/Index") },
        new { Titulo = "Switches",     Cantidad = ViewBag.sw,           Icono = "bi-diagram-3",   Url = Url.Content("~/Swichs/Index") },
        new { Titulo = "Escáneres",    Cantidad = ViewBag.es,           Icono = "bi-upc-scan",    Url = Url.Content("~/Escaner/Index") }
    };
}

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <h4 class="page-title">Panel general</h4>
        <p class="text-muted mb-0">Resumen del equipamiento informático registrado en SGEI.</p>
    </div>

    <div class="dropdown">
        <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-tools me-1"></i> Mantenimiento preventivo
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="~/Computadora/Preventivo"><i class="bi bi-pc-display me-2"></i>Computadoras</a></li>
            <li><a class="dropdown-item" href="~/Impresora/Preventivo"><i class="bi bi-printer me-2"></i>Impresoras</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" href="~/Inicio/Sugeridos"><i class="bi bi-lightbulb me-2"></i>Sugeridos</a></li>
        </ul>
    </div>
</div>

<div class="row g-3">
    @foreach (var equipo in equipos)
    {
        <div class="col-6 col-md-4 col-xxl-2">
            <a class="card sgei-kpi h-100 mb-0" href="@equipo.Url" data-spinner>
                <div class="card-body">
                    <span class="sgei-kpi-icono"><i class="bi @equipo.Icono"></i></span>
                    <div class="sgei-kpi-valor">@equipo.Cantidad</div>
                    <div class="sgei-kpi-titulo">@equipo.Titulo</div>
                </div>
            </a>
        </div>
    }
</div>
