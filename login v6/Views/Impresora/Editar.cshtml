
@model Negocio.DTO.DTO_Impresora_Editar
@{
    ViewBag.Title = "Editar Impresora";
}
<h2>Editar Camara</h2>
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <div class="card-box">
            <h4 class="mt-0 header-title"><b>EDITAR IMPRESORA</b></h4>
            <p class="text-muted mb-4 font-13">
                Use este wizard para editar la impresora seleccionado, recuerde que una vez editada podrá consultar el detalle de dicha impresora a travez de la busqueda de la misma como asi tambien volverla a editar.
            </p>

            @using (Html.BeginForm("GuardarImp", "Impresora", FormMethod.Post, new { id = "basic-form", data_wizard = "edicion" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.id_ubicacion_impresora)
                @Html.HiddenFor(x => x.id_detalle_ubicacion_impresora)
                @Html.HiddenFor(x => x.fecha_ubicacion)
                @Html.HiddenFor(x => x.ubicacion)

                <div>
                    <h3>Impresora</h3>

                    <section>
                        <div class="mb-3 clearfix">
                            @Html.Label("Seleccione el Modelo de la impresora")
                            @Html.DropDownListFor(x => x.mmarca, ViewBag.modelo as SelectList, new { @class = "form-select", @style = "width:250px;" })
                        </div>
                        <div class="mb-3 clearfix">
                            @Html.Label("Seleccione la ubicacion de la impresora")
                            @Html.DropDownListFor(x => x.ubicacion, ViewBag.ubicacion as SelectList, new { @class = "form-select", @style = "width:250px;", @disabled = "" })
                            <span class="form-text"><small>La ubicación se actualizará al mover el equipo de una ubicación a otra.</small></span>
                        </div>
                    </section>

                    <h3>Detalle</h3>
                    <section>
                        <div class="mb-3 clearfix">
                            @Html.Label("Ingrese descripcion de la Impresora")
                            @Html.TextBoxFor(x => x.descripcion, new { @class = "form-control", @style = "width:300px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.descripcion, null, new { @class = "text-danger small" })

                        </div>

                        <div class="mb-3 clearfix">
                            @Html.Label("Ingrese numero de IP de la Impresora")
                            @Html.TextBoxFor(x => x.ip, new { @class = "form-control", @style = "width:250px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.ip, null, new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3 clearfix">
                            @Html.Label("Computadora donde se conecta")
                            @Html.TextBoxFor(x => x.pc_donde_se_conecta, new { @class = "form-control", @style = "width:250px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.ip, null, new { @class = "text-danger small" })
                        </div>
                    </section>

                    <h3>Finalizar</h3>
                    <section>
                        @* Resumen de lo cargado (o de los cambios, en una edición): lo arma Scripts/app/sgei.js. *@
                        <div data-wizard-resumen></div>
                    </section>
                </div>

            }
            @*</form>*@
        </div>
    </div>
    <div class="col-md-2"></div>
</div>

