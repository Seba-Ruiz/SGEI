@model IEnumerable<Model.AspNetRoles>

@{
    ViewBag.Title = "Index";
}

<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Roles de usuarios") </li>
</ol>

<div class="row">

    <div class="offset-sm-2 col-sm-8">
        <div class="card-box">
            <div class="row">

                <div class="card card-acento-primary">
                    <div class="card-header">
                        <h3 class="card-title mb-0">Roles de Usuario</h3>
                        <p class="text-muted font-13">
                            En la siguiente tabla se muestran los distintos roles que los usuarios pueden tener. Presiona en "Detalle" para ver las funcionalidades asignadas a cada uno de los roles.
                        </p>
                    </div>

                    <div class="card-body">

                        <div class="p-3">

                            <table class="table table-hover sgei-grilla" data-grilla>

                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Nombre de Rol</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.Name</td>
                                        </tr>

                                    }
                                </tbody>

                            </table>

                        </div>

                    </div>
                </div>
                <div class="mb-3">
                    <div class="text-center">
                        <a class="btn btn-outline-secondary" href="~/Role/Detalle"> Detalle</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

