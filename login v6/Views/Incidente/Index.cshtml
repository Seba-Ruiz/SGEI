@model Model.incidente


@{
    ViewBag.Title = "Incidente";
    Model.ubicacion_impresora_id = ViewBag.ubicacion_impresora_id;
}


<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Cargar Incidente") </li>
</ol>

@using (Html.BeginForm("Guardar", "Incidente", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.ubicacion_impresora_id)


    <div class="row">
        <div class="col-sm-6 offset-sm-3">
            <div class="card card-acento-primary">
                <div class="card-header">
                    <h4 class="card-title mb-0">CARGA DE INCIDENTE</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                            <p class="text-muted mb-4 font-13">
                                Rellene los campos a continuación para detallar el incidente ocurrido y su acción de reparación.
                            </p>
                            <div class="mb-3">
                                @Html.Label("Descripcion del Incidente")
                                @Html.TextBoxFor(x => x.incidente1, new { @class = "form-control", @style = "width:500px;", @required="required" })
                                @Html.ValidationMessageFor(x => x.incidente1, null, new { @class = "text-danger small" })
                            </div>

                            <div class="mb-3">
                                @Html.Label("Fecha de Incidente")
                                @Html.TextBoxFor(x => x.fecha_incidente, new { @class = "form-control", type = "date", @style = "width:200px;" })
                                @Html.ValidationMessageFor(x => x.fecha_incidente, null, new { @class = "text-danger small" })
                            </div>

                            <div class="mb-3">
                                @Html.Label("Accion Realizada")
                                @Html.TextBoxFor(x => x.accion, new { @class = "form-control", @style = "width:500px;", @required = "required" })
                                @Html.ValidationMessageFor(x => x.accion, null, new { @class = "text-danger small" })
                            </div>

                            <div class="mb-3">
                                @Html.Label("Fecha de Accion Realizada")
                                @Html.TextBoxFor(x => x.fecha_accion, new { @class = "form-control", type = "date", @style = "width:200px;" })
                                @Html.ValidationMessageFor(x => x.fecha_accion, null, new { @class = "text-danger small" })
                            </div>


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="mostrarmodal" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    <h3>Atención</h3>
                </div>
                <div class="modal-body">
                    <h4>Desea agregar el incidente?</h4>
                    Al aceptar se agregara el incidente a la impresora. Luego podra consultar el incidente dentro del menu consultas!
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Aceptar</button>
                    @*<a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Aceptar</a>*@
                </div>
            </div>
        </div>
    </div>
}

<div class="text-center">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mostrarmodal">Agregar</button>
</div>



@**@





