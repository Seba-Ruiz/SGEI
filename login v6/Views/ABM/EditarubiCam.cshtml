@model Model.ubicacion_camara
@{
    ViewBag.Title = "Editar ubicación de cámaras";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Editar ubicación de cámaras</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Camara/Index">Cámaras</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/ubiCam">Ubicaciones</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardarubicam", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_ubicacion_camara)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Editar ubicación de cámaras</h5>
                <p class="sgei-form-card-ayuda">Modificá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.nombre, "Nombre", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.nombre, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: ACCESO PRINCIPAL", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.nombre, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/ubiCam">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
