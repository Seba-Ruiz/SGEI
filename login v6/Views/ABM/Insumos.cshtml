@model List<Model.insumo>
@{
    ViewBag.Title = "Insumos de impresoras";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Insumos de impresoras</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a href="~/Home/Index">Impresoras</a></li>
            <li class="breadcrumb-item active" aria-current="page">Insumos</li>
        </ol>
    </div>
    <a class="btn btn-primary" href="~/ABM/Crud" data-spinner><i class="bi bi-plus-lg me-1"></i>Nuevo insumo</a>
</div>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                    <th>Nombre</th>
                    <th>Cantidad</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                        <td>@a.nombre</td>
                        <td>@a.cantidad</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" aria-label="Editar" href="~/ABM/Editar/@a.id" data-spinner><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            @Html.BotonEliminar(Url.Content("~/ABM/EliminarInsumo/" + a.id), "¿Eliminar el insumo «" + a.nombre + "»?")
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
