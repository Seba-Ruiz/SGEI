@model List<Model.insumo>
@{
    /**/

    ViewBag.Title = "Insumos";
}
<h4 class="page-title">Insumos!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de los insumos") </li>
</ol>

@using (Html.BeginForm("Crud", "ABM", FormMethod.Post, new { id = "frm-insumo" }))
{
    @Html.AntiForgeryToken()

    <div class="vakata-context-left">
        <button type="submit" class="btn btn-primary">
            <span class="btn-label">
                <i class="bi bi-plus-lg"></i>
            </span>
            Agregar
        </button>
    </div>

}
<div class="col-md-2"></div>
<div class="col-md-8">

    <div class="card-box table-responsive">
        <table class="table table-striped m-0">
            <thead>
                <tr>
                    <th style="width:50px;">Detalle del nombre de Insumo</th>
                    <th style="width:50px;">Cantidad</th>
                    <th style="width:10px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <th>@a.nombre</th>
                        <th>@a.cantidad</th>
                        <th>
                            <a class="bi bi-pencil-square" title="Editar" href="~/ABM/Editar/@a.id"></a>

                            @Html.BotonEliminar(Url.Content("~/ABM/EliminarInsumo/" + a.id), "¿Desea eliminar el Insumo?", "bi bi-trash")
                        </th>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
<div class="col-md-2"></div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}