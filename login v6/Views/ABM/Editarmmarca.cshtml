@model Model.marca_modelo_cel
@{
    ViewBag.Title = "Editar modelo de teléfono";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Editar modelo de teléfono</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Telefonos/Index">Teléfonos</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/mmarcas">Modelos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardarmmarca", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_mm)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-tag" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Editar modelo de teléfono</h5>
                <p class="sgei-form-card-ayuda">Modificá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.descripcion, "Marca y modelo", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.descripcion, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: Panasonic KX-TS500", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.descripcion, null, new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(x => x.cantidad, "Cantidad", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.cantidad, new { @class = "form-control", required = "required", type = "number", min = "0" })
                @Html.ValidationMessageFor(x => x.cantidad, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/mmarcas">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
