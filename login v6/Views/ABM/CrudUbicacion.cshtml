@model Model.ubicacion
@{
    ViewBag.Title = "Nueva ubicación de impresoras";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Nueva ubicación de impresoras</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a href="~/Home/Index">Impresoras</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/Ubicacion">Ubicaciones</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nuevo</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("GuardarUbicacion", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Nueva ubicación de impresoras</h5>
                <p class="sgei-form-card-ayuda">Completá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.nombreUbicacion, "Nombre", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.nombreUbicacion, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: SISTEMAS", maxlength = "20" })
                @Html.ValidationMessageFor(x => x.nombreUbicacion, null, new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(x => x.responsable, "Responsable", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.responsable, new { @class = "form-control", required = "required", maxlength = "20" })
                @Html.ValidationMessageFor(x => x.responsable, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/Ubicacion">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
