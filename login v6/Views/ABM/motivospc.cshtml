@model List<Model.motivobajaPC>
@{
    ViewBag.Title = "Motivos de baja";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Motivos de baja</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a href="~/Computadora/Index">Computadoras</a></li>
            <li class="breadcrumb-item active" aria-current="page">Motivos de baja</li>
        </ol>
    </div>
    <a class="btn btn-primary" href="~/ABM/Crudmotivopc" data-spinner><i class="bi bi-plus-lg me-1"></i>Nuevo motivo</a>
</div>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                    <th>Motivo</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                        <td>@a.descripcion</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" aria-label="Editar" href="~/ABM/Editarmotivopc/@a.id_motivobaja" data-spinner><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            @Html.BotonEliminar(Url.Content("~/ABM/Eliminarmotivopc/" + a.id_motivobaja), "¿Eliminar el motivo de baja «" + a.descripcion + "»?")
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
