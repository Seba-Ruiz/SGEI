@model Model.Proveedor
@{
    ViewBag.Title = "Editar proveedor";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Editar proveedor</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/proveedores">Proveedores</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("GuardarProveedor", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-truck" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Editar proveedor</h5>
                <p class="sgei-form-card-ayuda">Modificá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.nombre, "Nombre", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.nombre, new { @class = "form-control", required = "required", autofocus = "autofocus", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.nombre, null, new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(x => x.telefono, "Teléfono", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.telefono, new { @class = "form-control", required = "required", placeholder = "Ej.: 2604 123456", type = "tel", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.telefono, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/proveedores">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
