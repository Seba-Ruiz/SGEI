@model List<Model.tipo_tel>
@{
    ViewBag.Title = "Tipos de teléfono";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Tipos de teléfono</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a href="~/Telefonos/Index">Teléfonos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tipos</li>
        </ol>
    </div>
    <a class="btn btn-primary" href="~/ABM/Crudtipo_tel" data-spinner><i class="bi bi-plus-lg me-1"></i>Nuevo tipo</a>
</div>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                    <th>Tipo</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                        <td>@a.nombre_tipo</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" aria-label="Editar" href="~/ABM/Editartipo_tel/@a.id_tipo" data-spinner><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            @Html.BotonEliminar(Url.Content("~/ABM/Eliminartipo_tel/" + a.id_tipo), "¿Eliminar el tipo «" + a.nombre_tipo + "»?")
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
