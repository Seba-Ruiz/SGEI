@model Model.tipo_tel
@{
    ViewBag.Title = "Nuevo tipo de teléfono";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Nuevo tipo de teléfono</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a href="~/Telefonos/Index">Teléfonos</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/tipo_telefonos">Tipos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nuevo</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardartipo_tel", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-collection" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Nuevo tipo de teléfono</h5>
                <p class="sgei-form-card-ayuda">Completá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.nombre_tipo, "Tipo de teléfono", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.nombre_tipo, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: IP", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.nombre_tipo, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/tipo_telefonos">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
