@model Model.marca_modelo_camara
@{
    ViewBag.Title = "Editar modelo de cámara";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Editar modelo de cámara</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Camara/Index">Cámaras</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/modeloCam">Modelos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardarmmarcacam", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_mmarca)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-tag" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Editar modelo de cámara</h5>
                <p class="sgei-form-card-ayuda">Modificá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.marca_modelo, "Marca y modelo", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.marca_modelo, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: Hikvision DS-2CD1023", maxlength = "100" })
                @Html.ValidationMessageFor(x => x.marca_modelo, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/modeloCam">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
