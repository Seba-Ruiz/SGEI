@model List<Model.ubicacion_escaner>
@{
    ViewBag.Title = "Ubicacion Escaner";
}
<h4 class="page-title">Ubicacion Camara</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Ubicacion de Escaner") </li>
</ol>
@using (Html.BeginForm("CrudubicacionES", "ABM", FormMethod.Post, new { id = "frm-insumo" }))
{
    @Html.AntiForgeryToken()
    <div class="vakata-context-left">
        <button type="submit" class="btn btn-primary">
            <span class="btn-label">
                <i class="bi bi-plus-lg"></i>
            </span>
            Agregar
        </button>
    </div>

}
<div class="col-md-2"></div>
<div class="col-md-8">
    <div class="card-box">
        <table class="table table-hover sgei-grilla" data-grilla>
            <thead>
                <tr>
                    <th>Nombre Ubicacion</th>
                    <th class="sgei-col-acciones">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.nombre</td>
                        <td>
                            <div class="sgei-acciones">
                                <a class="sgei-accion" title="Editar" href="~/ABM/EditarubicacionES/@a.id_ubicacion_escaner" aria-label="Editar"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                @Html.BotonEliminar(Url.Content("~/ABM/EliminarubicacionES/" + a.id_ubicacion_escaner), "¿Desea eliminar la ubicacion?", "bi bi-trash")
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="col-md-2"></div>

