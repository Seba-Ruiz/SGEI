@model Model.insumo
@{
    ViewBag.Title = "Nuevo insumo de impresora";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Nuevo insumo de impresora</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Home/Index">Impresoras</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/Insumos">Insumos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nuevo</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardar", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @* La cantidad empieza en 0: se carga desde Ingresos. *@
    <input type="hidden" name="cantidad" value="0" />

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Nuevo insumo de impresora</h5>
                <p class="sgei-form-card-ayuda">Completá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.nombre, "Nombre del insumo", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.nombre, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: Tóner HP 85A", maxlength = "20" })
                @Html.ValidationMessageFor(x => x.nombre, null, new { @class = "text-danger small" })
            </div>
            <div class="form-text"><i class="bi bi-info-circle me-1"></i>La cantidad empieza en 0 y se carga desde <strong>Ingresos</strong> &gt; Cargar insumos.</div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/Insumos">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
