@model List<Model.impresora>
@{
    ViewBag.Title = "Impresoras";
}

<h4 class="page-title">Consulta!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de impresoras") </li>
</ol>

@using (Html.BeginForm("CrudImpresora", "ABM", FormMethod.Post, new { id = "frm-insumo" }))
{
    @Html.AntiForgeryToken()
    <div class="vakata-context-left">
        <button type="submit" class="btn btn-primary">
            <span class="btn-label">
                <i class="bi bi-plus-lg"></i>
            </span>
            Agregar
        </button>
    </div>

}
<div class="col-md-2"></div>
<div class="col-md-8">

    <div class="card-box">
        <table class="table table-hover sgei-grilla" data-grilla>
            <thead>
                <tr>
                    <th>Marca y Modelo de la Impresora</th>
                    <th>Tipo</th>
                    <th class="sgei-col-acciones">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.marca_modelo</td>
                        <td>@a.tipo</td>

                        <td>
                            <div class="sgei-acciones">
                                <a class="sgei-accion" title="Editar" href="~/ABM/EditarImpresora/@a.id" aria-label="Editar"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                @Html.BotonEliminar(Url.Content("~/ABM/EliminarImpresora/" + a.id), "¿Desea eliminar la impresora?", "bi bi-trash")
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
    </div>
<div class="col-md-2"></div>