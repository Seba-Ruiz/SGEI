@model List<Model.ubicacion_tel>
@{
    ViewBag.Title = "Ubicaciones de Telefonos";
}
<h4 class="page-title">Ubicacion Telefonos!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Ubicaciones") </li>
</ol>

@using (Html.BeginForm("Crudubicaciontel", "ABM", FormMethod.Post, new { id = "frm-insumo" }))
{
    @Html.AntiForgeryToken()
    <div class="vakata-context-left">
        <button type="submit" class="btn btn-primary">
            <span class="btn-label">
                <i class="bi bi-plus-lg"></i>
            </span>
            Agregar
        </button>
    </div>

}
<div class="col-md-2"></div>
<div class="col-md-8">
    <div class="card-box">
        <table class="table table-hover sgei-grilla" data-grilla>
            <thead>
                <tr>
                    <th>Descripcion</th>
                    <th class="sgei-col-acciones">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.nombre_ubi</td>
                        <td>
                            <div class="sgei-acciones">
                                <a class="sgei-accion" title="Editar" href="~/ABM/Editarubicaciontel/@a.id_ubicacion_tel" aria-label="Editar"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                @Html.BotonEliminar(Url.Content("~/ABM/Eliminarubicaciontel/" + a.id_ubicacion_tel), "¿Desea eliminar la ubicacion?", "bi bi-trash")
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
<div class="col-md-2"></div>


