@model Model.ubicacion_camara
@{
    ViewBag.Title = "Nuevo Registro";
}
<h4 class="page-title">Nueva Ubicacion</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Ubicacion Camara") </li>
</ol>
@using (Html.BeginForm("Guardarubicam", "ABM", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @*@Html.HiddenFor(x => x.id)*@
    <div class="row">
        <div class="col-sm-3"></div>
        <div class="col-sm-6">
            <div class="card-box">
                <h4 class="mt-0 mb-3 header-title"><b>NUEVA UBICACION DE  CAMARA</b></h4>
                <div class="row">
                    <div class="col-md-12">
                        <h5><b>Agregue una nueva ubicacion para las camaras</b></h5>
                        <p class="text-muted mb-4 font-13">
                            Llene los campos a continuacion para agregar una nueva ubicacion de camara.
                        </p>
                        <div class="mb-3">
                            @Html.Label("Ingrese Ubicacion")
                            @Html.TextBoxFor(x => x.nombre, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.nombre, null, new { @class = "text-danger small" })
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="mostrarmodal" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    <h3>Atención</h3>
                </div>
                <div class="modal-body">
                    <h4>Desea agregar la nueva ubicacion?</h4>
                    Al aceptar se agregara a la lista de ubicaciones de camaras. Podra eliminar la ubicacion de dicha lista posteriormente.
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Aceptar</button>
                    @*<a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Aceptar</a>*@
                </div>
            </div>
        </div>
    </div>
}

<div class="text-center">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mostrarmodal">Agregar</button>
</div>

