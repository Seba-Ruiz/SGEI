@model Model.Proveedor
@{
    ViewBag.Title = "Nuevo Proveedor";
}
<h4 class="page-title">Nuevo Registro</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Proveedor") </li>
</ol>
@using (Html.BeginForm("GuardarProveedor", "ABM", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @*@Html.HiddenFor(x => x.id)*@
    <div class="row">
        <div class="col-sm-3"></div>
        <div class="col-sm-6">
            <div class="card-box">
                <h4 class="mt-0 mb-3 header-title"><b>NUEVO PROVEEDOR</b></h4>
                <div class="row">
                    <div class="col-md-12">
                        <h5><b>Agregue un nuevo proveedor de insumos</b></h5>
                        <p class="text-muted mb-4 font-13">
                            Llene los campos a continuación para agregar un nuevo proveedor en el sistema.
                        </p>
                        <div class="mb-3">
                            @Html.Label("Ingrese Proveedor")
                            @Html.TextBoxFor(x => x.nombre, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.nombre, null, new { @class = "text-danger small" })
                        </div>
                        <div class="mb-3">
                            @Html.Label("Ingrese Telefono")
                            @Html.TextBoxFor(x => x.telefono, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.telefono, null, new { @class = "text-danger small" })
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="mostrarmodal" data-abrir-al-cargar tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    <h3>Atención</h3>
                </div>
                <div class="modal-body">
                    <h4>Desea agregar el proveedor?</h4>
                    Al aceptar se agregara a la lista de proveedores el proveedor. Podra eliminar el proveedor de dicha lista posteriormente.
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Aceptar</button>
                    @*<a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Aceptar</a>*@
                </div>
            </div>
        </div>
    </div>
}
<div class="text-center">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mostrarmodal">Agregar</button>
</div>

@**@
