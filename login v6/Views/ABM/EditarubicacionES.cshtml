@model Model.ubicacion_escaner
@{
    ViewBag.Title = "Editar Ubicacion de Escaner";
}
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@(Model.id_ubicacion_escaner > 0 ? Model.nombre : "Editar Ubicacion") </li>
</ol>
@using (Html.BeginForm("GuardarubicacionES", "ABM", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_ubicacion_escaner)
    <div class="row">
        <div class="col-sm-3"></div>
        <div class="col-sm-6">
            <div class="card-box">
                <h4 class="mt-0 mb-3 header-title"><b>EDITAR LA UBICACION DE ESCANER</b></h4>
                <div class="row">
                    <div class="col-md-12">
                        <h5><b>Edita las propiedades de LA ubicacion </b></h5>
                        <p class="text-muted mb-4 font-13">
                            Edite la ubicacion
                        </p>
                        <div class="mb-3">
                            @Html.Label("Ingrese Ubicacion")
                            @Html.TextBoxFor(x => x.nombre, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.nombre, null, new { @class = "text-danger small" })
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>

}
