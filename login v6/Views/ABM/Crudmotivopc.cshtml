@model Model.motivobajaPC

@{
    ViewBag.Title = "Motivo de Baja de PCs";
}

<h4 class="page-title">Nuevo Tipo de PCs!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Motivo de Baja PC") </li>
</ol>

@using (Html.BeginForm("Guardarmotivopc", "ABM", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @*@Html.HiddenFor(x => x.id)*@
    <div class="row">
        <div class="col-sm-3"></div>
        <div class="col-sm-6">
            <div class="card-box">
                <h4 class="mt-0 mb-3 header-title"><b>NUEVO MOTIVO DE BAJA DE PC</b></h4>

                <div class="row">
                    <div class="col-md-12">
                        <h5><b>Agregue un nuevo Tipo de PC</b></h5>
                        <p class="text-muted mb-4 font-13">
                            Llene los campos a continuacion para agregar un nuevo Motivo de Baja de PC.
                        </p>
                        <div class="mb-3">
                            @Html.Label("Ingrese Motivo de Baja de PC")
                            @Html.TextBoxFor(x => x.descripcion, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.descripcion, null, new { @class = "text-danger small" })
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="mostrarmodal" data-abrir-al-cargar tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    <h3>Atención</h3>
                </div>
                <div class="modal-body">
                    <h4>Desea agregar el nuevo Motivo de Baja de PC?</h4>
                    Al aceptar se agregara a la lista de Motivos de Baja de PCs. Podra eliminar el Motivo de Baja de dicha lista.
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Aceptar</button>
                    @*<a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Aceptar</a>*@
                </div>
            </div>
        </div>
    </div>
}

<div class="text-center">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mostrarmodal">Agregar</button>
</div>



@**@
