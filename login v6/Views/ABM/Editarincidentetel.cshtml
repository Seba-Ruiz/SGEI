@model Model.incidente_tel

@{
    ViewBag.Title = "Editar Incidente";
}

<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@(Model.id_incidente_tel > 0 ? Model.nombre_incidente : "Editar Incidente") </li>
</ol>

@using (Html.BeginForm("Guardarincidentetel", "ABM", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_incidente_tel)
    <div class="row">
        <div class="col-sm-3"></div>
        <div class="col-sm-6">
            <div class="card-box">
                <h4 class="mt-0 mb-3 header-title"><b>EDITAR INCIDENTE DE TELEFONO</b></h4>

                <div class="row">
                    <div class="col-md-12">
                        <h5><b>Edita las propiedades del incidente del telefono </b></h5>
                        <p class="text-muted mb-4 font-13">
                            Edite el incidente.
                        </p>
                        <div class="mb-3">
                            @Html.Label("Ingrese Incidente del Telefono")
                            @Html.TextBoxFor(x => x.nombre_incidente, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.nombre_incidente, null, new { @class = "text-danger small" })
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>

}
