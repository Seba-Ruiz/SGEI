@model Model.incidente_tel
@{
    ViewBag.Title = "Editar incidente de teléfono";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Editar incidente de teléfono</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Telefonos/Index">Teléfonos</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/incidentestel">Incidentes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardarincidentetel", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_incidente_tel)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Editar incidente de teléfono</h5>
                <p class="sgei-form-card-ayuda">Modificá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.nombre_incidente, "Incidente", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.nombre_incidente, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: Sin tono", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.nombre_incidente, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/incidentestel">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
