@model List<Model.ubicacion>
@{
    ViewBag.Title = "Ubicacion";
}

<h4 class="page-title">Ubicaciones!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de las ubicaciones") </li>
</ol>

@using (Html.BeginForm("CrudUbicacion", "ABM", FormMethod.Post, new { id = "frm-insumo" }))
{
    @Html.AntiForgeryToken()
    <div class="vakata-context-left">
        <button type="submit" class="btn btn-primary">
            <span class="btn-label">
                <i class="bi bi-plus-lg"></i>
            </span>
            Agregar
        </button>
    </div>

}
<div class="col-md-2"></div>
<div class="col-md-8">

    <div class="card-box">
        <table class="table table-hover sgei-grilla" data-grilla>
            <thead>
                <tr>
                    <th>Nombre de Ubicacion</th>
                    <th>Responsable</th>
                    <th class="sgei-col-acciones">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.nombreUbicacion</td>
                        <td>@a.responsable</td>

                        <td>
                            <div class="sgei-acciones">
                                <a class="sgei-accion" title="Editar" href="~/ABM/EditarUbicacion/@a.id" aria-label="Editar"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                @Html.BotonEliminar(Url.Content("~/ABM/EliminarUbicacion/" + a.id), "¿Desea eliminar la Ubicacion?", "bi bi-trash")
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
    </div>
<div class="col-md-2"></div>