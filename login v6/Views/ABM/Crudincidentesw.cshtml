@model Model.incidente_switch

@{
    ViewBag.Title = "Nuevo Registro";
}

<h4 class="page-title">Nuevo Incidente</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Incidente Switch") </li>
</ol>

@using (Html.BeginForm("Guardarincidentesw", "ABM", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @*@Html.HiddenFor(x => x.id)*@
    <div class="row">
        <div class="col-sm-3"></div>
        <div class="col-sm-6">
            <div class="card-box">
                <h4 class="mt-0 mb-3 header-title"><b>NUEVO INCIDENTE SWITCH</b></h4>

                <div class="row">
                    <div class="col-md-12">
                        <h5><b>Agregue un nuevo incidente para los switch</b></h5>
                        <p class="text-muted mb-4 font-13">
                            Llene los campos a continuacion para agregar un nuevo incidente para los switch.
                        </p>
                        <div class="mb-3">
                            @Html.Label("Ingrese Incidente")
                            @Html.TextBoxFor(x => x.descripcion, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.descripcion, null, new { @class = "text-danger small" })
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="mostrarmodal" data-abrir-al-cargar tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    <h3>Atención</h3>
                </div>
                <div class="modal-body">
                    <h4>Desea agregar el nuevo incidente?</h4>
                    Al aceptar se agregara a la lista de incidentes de switchs. Podra eliminar el incidente de dicha lista posteriormente.
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Aceptar</button>
                    @*<a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Aceptar</a>*@
                </div>
            </div>
        </div>
    </div>
}

<div class="text-center">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mostrarmodal">Agregar</button>
</div>



@**@

