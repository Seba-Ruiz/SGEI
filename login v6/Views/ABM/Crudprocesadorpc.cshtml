@model Model.procesadorPC
@{
    ViewBag.Title = "Nuevo procesador";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Nuevo procesador</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Computadora/Index">Computadoras</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/procesadorespc">Procesadores</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nuevo</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardarprocesadorpc", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-cpu" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Nuevo procesador</h5>
                <p class="sgei-form-card-ayuda">Completá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.descripcion, "Procesador", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.descripcion, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: Intel Core i5-10400", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.descripcion, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/procesadorespc">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
