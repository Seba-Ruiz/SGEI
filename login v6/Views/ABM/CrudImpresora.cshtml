@model Model.impresora

@{
    ViewBag.Title = (Model.id > 0 ? Model.marca_modelo : "Nuevo Registro");
}

<h4 class="page-title">Nueva Impresora!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Nueva Impresora") </li>
</ol>

@using (Html.BeginForm("GuardarImpresora", "ABM", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @*@Html.HiddenFor(x => x.id)*@
    <div class="row">
        <div class="col-sm-3"></div>
        <div class="col-sm-6">
            <div class="card-box">
                <h4 class="mt-0 mb-3 header-title"><b>NUEVA IMPRESORA</b></h4>

                <div class="row">
                    <div class="col-md-12">
                        <h5><b>Agregue una impresora al sistema</b></h5>
                        <p class="text-muted mb-4 font-13">
                            Llene los campos a continuacion para agregar la impresora nueva.
                        </p>
                        <div class="mb-3">
                            @Html.Label("Ingrese marca y modelo de la impresora")
                            @Html.TextBoxFor(x => x.marca_modelo, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.marca_modelo, null, new { @class = "text-danger small" })
                        </div>
                        <div class="mb-3">
                            <div class="mb-3">
                                @Html.Label("Tipo de Conexion")
                                <select name="Tipo" class="form-select" style="width:200px;">
                                    <option @(Model.tipo == "LOCAL" ? "selected" : "") value="LOCAL">LOCAL</option>
                                    <option @(Model.tipo == "RED" ? "selected" : "") value="RED">RED</option>
                                </select>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="mostrarmodal" data-abrir-al-cargar tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    <h3>Atención</h3>
                </div>
                <div class="modal-body">
                    <h4>Desea agregar la impresora?</h4>
                    Al aceptar se agregara a la lista de impresoras. Podra eliminar la impresora desde dicha lista.
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Aceptar</button>
                    @*<a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Aceptar</a>*@
                </div>
            </div>
        </div>
    </div>
}

<div class="text-center">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mostrarmodal">Agregar</button>
</div>



@**@
