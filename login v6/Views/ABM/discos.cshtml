@model List<Model.discoPC>
@{
    ViewBag.Title = "Discos";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Discos</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Computadora/Index">Computadoras</a></li>
            <li class="breadcrumb-item active" aria-current="page">Discos</li>
        </ol>
    </div>
    <a class="btn btn-primary" href="~/ABM/CrudDisco" data-spinner><i class="bi bi-plus-lg me-1"></i>Nuevo disco</a>
</div>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                    <th>Capacidad</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                        <td>@a.descripcion</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" aria-label="Editar" href="~/ABM/EditarDisco/@a.id_disco" data-spinner><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            @Html.BotonEliminar(Url.Content("~/ABM/EliminarDisco/" + a.id_disco), "¿Eliminar el disco «" + a.descripcion + "»?")
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
