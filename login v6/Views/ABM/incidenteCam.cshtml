@model List<Model.incidente_camara>
@{
    ViewBag.Title = "Incidentes de cámaras";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Incidentes de cámaras</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a href="~/Camara/Index">Cámaras</a></li>
            <li class="breadcrumb-item active" aria-current="page">Incidentes</li>
        </ol>
    </div>
    <a class="btn btn-primary" href="~/ABM/Crudincidentecam" data-spinner><i class="bi bi-plus-lg me-1"></i>Nuevo incidente</a>
</div>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                    <th>Incidente</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                        <td>@a.descripcion</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" aria-label="Editar" href="~/ABM/EditarincidenteCam/@a.id_incidente" data-spinner><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            @Html.BotonEliminar(Url.Content("~/ABM/EliminarincidenteCam/" + a.id_incidente), "¿Eliminar el incidente «" + a.descripcion + "»?")
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
