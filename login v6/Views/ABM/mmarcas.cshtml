@model List<Model.marca_modelo_cel>
@{
    ViewBag.Title = "Modelos de teléfono";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Modelos de teléfono</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Telefonos/Index">Teléfonos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modelos</li>
        </ol>
    </div>
    <a class="btn btn-primary" href="~/ABM/Crudmmarca" data-spinner><i class="bi bi-plus-lg me-1"></i>Nuevo modelo</a>
</div>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                    <th>Modelo</th>
                    <th>Cantidad</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                        <td>@a.descripcion</td>
                        <td>@a.cantidad</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" aria-label="Editar" href="~/ABM/Editarmmarca/@a.id_mm" data-spinner><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            @Html.BotonEliminar(Url.Content("~/ABM/Eliminarmmarca/" + a.id_mm), "¿Eliminar el modelo «" + a.descripcion + "»?")
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
