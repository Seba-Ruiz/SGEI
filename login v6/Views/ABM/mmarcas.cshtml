@model List<Model.marca_modelo_cel>
@{
    ViewBag.Title = "Modelos de Telefonos";
}
<h4 class="page-title">Modelos!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Modelos") </li>
</ol>

@using (Html.BeginForm("Crudmmarca", "ABM", FormMethod.Post, new { id = "frm-insumo" }))
{
    @Html.AntiForgeryToken()
    <div class="vakata-context-left">
        <button type="submit" class="btn btn-primary">
            <span class="btn-label">
                <i class="bi bi-plus-lg"></i>
            </span>
            Agregar
        </button>
    </div>

}
<div class="col-md-2"></div>
<div class="col-md-8">
    <div class="card-box">
        <table class="table table-hover sgei-grilla" data-grilla>
            <thead>
                <tr>
                    <th>Descripcion</th>
                    <th>Cantidad</th>
                    <th class="sgei-col-acciones">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                <tr>
                    <td>@a.descripcion</td>
                    <td>@a.cantidad</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" href="~/ABM/Editarmmarca/@a.id_mm" aria-label="Editar"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            @Html.BotonEliminar(Url.Content("~/ABM/Eliminarmmarca/" + a.id_mm), "¿Desea eliminar el modelo?", "bi bi-trash")
                        </div>
                    </td>
                </tr>
                }
            </tbody>

        </table>
    </div>
</div>
<div class="col-md-2"></div>


