@model Model.tipoPC
@{
    ViewBag.Title = "Editar tipo de computadora";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Editar tipo de computadora</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Computadora/Index">Computadoras</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/tipospc">Tipos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardartipopc", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_tipo)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-collection" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Editar tipo de computadora</h5>
                <p class="sgei-form-card-ayuda">Modificá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.nombre_tipo, "Tipo de computadora", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.nombre_tipo, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: Escritorio", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.nombre_tipo, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/tipospc">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
