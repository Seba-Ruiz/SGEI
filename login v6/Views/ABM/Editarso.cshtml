@model Model.soPC
@{
    ViewBag.Title = "Editar sistema operativo";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Editar sistema operativo</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Computadora/Index">Computadoras</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/sos">Sistemas operativos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardarso", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_so)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-windows" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Editar sistema operativo</h5>
                <p class="sgei-form-card-ayuda">Modificá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.descripcion, "Sistema operativo", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.descripcion, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: Windows 11 Pro", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.descripcion, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/sos">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
