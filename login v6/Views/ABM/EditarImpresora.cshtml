@model Model.impresora
@{
    ViewBag.Title = "Editar modelo de impresora";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Editar modelo de impresora</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Home/Index">Impresoras</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/Impresoras">Modelos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("GuardarImpresora", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-tag" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Editar modelo de impresora</h5>
                <p class="sgei-form-card-ayuda">Modificá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.marca_modelo, "Marca y modelo", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.marca_modelo, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: HP LaserJet Pro M404", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.marca_modelo, null, new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(x => x.tipo, "Tipo de conexión", new { @class = "form-label sgei-requerido" })
                <select class="form-select" id="tipo" name="tipo" required>
                    <option value="LOCAL" @(Model.tipo == "LOCAL" ? "selected" : "")>Local (USB)</option>
                    <option value="RED" @(Model.tipo == "RED" ? "selected" : "")>Red</option>
                </select>
                @Html.ValidationMessageFor(x => x.tipo, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/Impresoras">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
