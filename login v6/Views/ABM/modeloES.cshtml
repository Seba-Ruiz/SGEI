@model List<Model.marca_modelo_escaner>
@{
    ViewBag.Title = "Modelos de escáneres";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Modelos de escáneres</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Escaner/Index">Escáneres</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modelos</li>
        </ol>
    </div>
    <a class="btn btn-primary" href="~/ABM/CrudmodeloES" data-spinner><i class="bi bi-plus-lg me-1"></i>Nuevo modelo</a>
</div>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                    <th>Marca y modelo</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                        <td>@a.descripcion</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" aria-label="Editar" href="~/ABM/EditarmodeloES/@a.id_marca_modelo_escaner" data-spinner><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            @Html.BotonEliminar(Url.Content("~/ABM/EliminarmodeloES/" + a.id_marca_modelo_escaner), "¿Eliminar el modelo «" + a.descripcion + "»?")
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
