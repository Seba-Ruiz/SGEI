@model Model.marca_modelo_switch
@{
    ViewBag.Title = "Nuevo modelo de switch";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Nuevo modelo de switch</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Swichs/Index">Switches</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/modeloSW">Modelos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nuevo</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("Guardarmodelosw", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-tag" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Nuevo modelo de switch</h5>
                <p class="sgei-form-card-ayuda">Completá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.marca_modelo, "Marca y modelo", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.marca_modelo, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: TP-Link TL-SG1024", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.marca_modelo, null, new { @class = "text-danger small" })
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/modeloSW">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
