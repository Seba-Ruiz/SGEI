@model Model.insumo_camara
@{
    ViewBag.Title = "Editar insumo de cámara";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Editar insumo de cámara</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a href="~/Camara/Index">Cámaras</a></li>
            <li class="breadcrumb-item"><a href="~/ABM/insumosCam">Insumos</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </div>
</div>

@using (Html.BeginForm("GuardarinsumoCam", "ABM", FormMethod.Post, new { @class = "sgei-formulario" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_insumo)
    @Html.HiddenFor(x => x.cantidad)

    <div class="card sgei-form-card">
        <div class="card-header">
            <span class="sgei-form-card-icono"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
            <div>
                <h5 class="sgei-form-card-titulo">Editar insumo de cámara</h5>
                <p class="sgei-form-card-ayuda">Modificá los datos y presioná Guardar.</p>
            </div>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(x => x.nombre, "Nombre del insumo", new { @class = "form-label sgei-requerido" })
                @Html.TextBoxFor(x => x.nombre, new { @class = "form-control", required = "required", autofocus = "autofocus", placeholder = "Ej.: Fuente 12 V", maxlength = "50" })
                @Html.ValidationMessageFor(x => x.nombre, null, new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                <label class="form-label" for="cantidad-actual">Cantidad disponible</label>
                <input class="form-control" id="cantidad-actual" value="@Model.cantidad" readonly />
                <div class="form-text"><i class="bi bi-info-circle me-1"></i>La cantidad se modifica desde <strong>Ingresos</strong> &gt; Cargar insumos.</div>
            </div>
        </div>
        <div class="card-footer">
            <a class="btn btn-outline-secondary" href="~/ABM/insumosCam">Cancelar</a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
        </div>
    </div>
}
