@model Model.insumo_camara
@{
    ViewBag.Title = "Editar Insumo Camara";
}
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@(Model.id_insumo > 0 ? Model.nombre : "Editar Insumo") </li>
</ol>
@using (Html.BeginForm("GuardarinsumoCam", "ABM", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.id_insumo)
    @Html.HiddenFor(x => x.cantidad)
    <div class="row">
        <div class="col-sm-3"></div>
        <div class="col-sm-6">
            <div class="card-box">
                <h4 class="mt-0 mb-3 header-title"><b>EDITAR INSUMO DE CAMARA</b></h4>
                <div class="row">
                    <div class="col-md-12">
                        <h5><b>Edita las propiedades del insumo </b></h5>
                        <p class="text-muted mb-4 font-13">
                            Edite el insumo.
                        </p>
                        <div class="mb-3">
                            @Html.Label("Ingrese Insumo")
                            @Html.TextBoxFor(x => x.nombre, new { @class = "form-control", @style = "width:200px;", @required = "required" })
                            @Html.ValidationMessageFor(x => x.nombre, null, new { @class = "text-danger small" })
                        </div>
                        <div class="mb-3">
                            @Html.Label("Ingrese Cantidad")
                            @Html.TextBoxFor(x => x.cantidad, new { @class = "form-control", @style = "width:200px;", @disabled = "disabled" })
                            @Html.ValidationMessageFor(x => x.cantidad, null, new { @class = "text-danger small" })
                            <span class="form-text"><small>Para editar la cantidad de insumos vaya al apartado Ingresos.</small></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>

}
