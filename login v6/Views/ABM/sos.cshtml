@model List<Model.soPC>
@{
    ViewBag.Title = "Sistemas Operativos";
}
<h4 class="page-title">Sistemas Operativos!</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Sistemas Operativos") </li>
</ol>

@using (Html.BeginForm("Crudso", "ABM", FormMethod.Post, new { id = "frm-insumo" }))
{
    @Html.AntiForgeryToken()
    <div class="vakata-context-left">
        <button type="submit" class="btn btn-primary">
            <span class="btn-label">
                <i class="bi bi-plus-lg"></i>
            </span>
            Agregar
        </button>
    </div>

}
<div class="col-md-2"></div>
<div class="col-md-8">
    <div class="card-box table-responsive">
        <table class="table table-striped m-0">
            <thead>
                <tr>
                    <th style="width:50px;">Descripcion</th>
                    <th style="width:10px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <th>@a.descripcion</th>
                        <th>
                            <a class="bi bi-pencil-square" title="Editar" href="~/ABM/Editarso/@a.id_so"></a>

                            @Html.BotonEliminar(Url.Content("~/ABM/Eliminarso/" + a.id_so), "¿Desea eliminar el SO?", "bi bi-trash")
                        </th>
                    </tr>
                }
            </tbody>

        </table>
    </div>
    </div>
<div class="col-md-2"></div>



