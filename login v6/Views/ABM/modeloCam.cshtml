@model List<Model.marca_modelo_camara>
@{
    ViewBag.Title = "Modelos de cámaras";
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Modelos de cámaras</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="~/Camara/Index">Cámaras</a></li>
            <li class="breadcrumb-item active" aria-current="page">Modelos</li>
        </ol>
    </div>
    <a class="btn btn-primary" href="~/ABM/Crudmmaarcacam" data-spinner><i class="bi bi-plus-lg me-1"></i>Nuevo modelo</a>
</div>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                    <th>Marca y modelo</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                        <td>@a.marca_modelo</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" aria-label="Editar" href="~/ABM/EditarmodeloCam/@a.id_mmarca" data-spinner><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            @Html.BotonEliminar(Url.Content("~/ABM/EliminarmodeloCam/" + a.id_mmarca), "¿Eliminar el modelo «" + a.marca_modelo + "»?")
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
