@model Negocio.DTO.DTO_TicketDetalle
@using Negocio.DTO
@using Negocio.Servicio
@using login_v6.Seguridad
@{
    ViewBag.Title = "Ticket #" + Model.Id;
    var usuarioId = (string)ViewBag.UsuarioId;
    var esAdmin = (bool)ViewBag.EsAdministrador;
    var puedeMover = (bool)ViewBag.PuedeMover;
    var error = TempData["ticket.error"] as string;
    var borrador = TempData["ticket.borrador"] as string;
    Func<DateTime, string> cuando = d => d.ToString("dd/MM/yyyy HH:mm");
}

@helper Estado(string nombre)
{
    var estado = Negocio.Servicio.EstadosTicket.Todos.FirstOrDefault(e => Negocio.Servicio.EstadosTicket.Nombre(e) == nombre);
    <span class="sgei-estado sgei-estado-@estado">@nombre</span>
}

@helper Evento(DTO_TicketActividad a)
{
    switch (a.Campo)
    {
        case "ALTA":
            <text>creó el ticket y lo asignó a <strong>@a.Nuevo</strong></text>
            break;
        case "ESTADO":
            <text>movió el ticket de @Estado(a.Anterior) a @Estado(a.Nuevo)</text>
            break;
        case "ASIGNADO":
            <text>reasignó el ticket de <strong>@a.Anterior</strong> a <strong>@a.Nuevo</strong></text>
            break;
        case "PRIORIDAD":
            <text>cambió la prioridad de <strong>@a.Anterior</strong> a <strong>@a.Nuevo</strong></text>
            break;
        case "FECHA_PREVISTA":
            <text>cambió la fecha prevista de <strong>@a.Anterior</strong> a <strong>@a.Nuevo</strong></text>
            break;
        case "TITULO":
            <text>cambió el título de <strong>«@a.Anterior»</strong> a <strong>«@a.Nuevo»</strong></text>
            break;
        case "EQUIPO":
            <text>cambió el equipo de <strong>@(a.Anterior ?? "ninguno")</strong> a <strong>@(a.Nuevo ?? "ninguno")</strong></text>
            break;
        case "DESCRIPCION":
            <text>modificó la descripción</text>
            break;
        default:
            <text>modificó @a.Campo</text>
            break;
    }
}

<div class="sgei-encabezado">
    <div>
        <h4 class="page-title">Ticket #@Model.Id</h4>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Tickets</a></li>
            <li class="breadcrumb-item active" aria-current="page">#@Model.Id</li>
        </ol>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index")" data-spinner><i class="bi bi-kanban me-1"></i>Volver al board</a>
        @if (esAdmin)
        {
            <a class="btn btn-primary" href="@Url.Action("Editar", new { id = Model.Id })" data-spinner><i class="bi bi-pencil me-1"></i>Editar</a>
        }
    </div>
</div>

@if (error != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>@error</div>
}

<div class="row g-3 sgei-ticket-detalle">
    <div class="col-lg-8">
        <div class="card sgei-ticket-principal sgei-ticket-prioridad-@Model.Prioridad">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="sgei-ticket-numero">#@Model.Id</span>
                    <span class="sgei-estado sgei-estado-@Model.Estado">@EstadosTicket.Nombre(Model.Estado)</span>
                    <span class="sgei-prioridad sgei-prioridad-@Model.Prioridad"><i class="bi bi-flag-fill" aria-hidden="true"></i>@PrioridadesTicket.Nombre(Model.Prioridad)</span>
                    <span class="sgei-plazo sgei-plazo-@Model.Semaforo">@Model.TextoPlazo</span>
                </div>
                <h5 class="sgei-ticket-detalle-titulo">@Model.Titulo</h5>
                @if (string.IsNullOrEmpty(Model.Descripcion))
                {
                    <p class="text-muted fst-italic mb-0">Sin descripción.</p>
                }
                else
                {
                    @* HTML saneado al guardar (Negocio/Servicio/HtmlSeguro.cs). *@
                    <div class="sgei-html">@Html.Raw(Model.Descripcion)</div>
                }
            </div>
        </div>

        <div class="card mt-3" id="actividad">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                <h5 class="mb-0 fs-6 fw-semibold">Conversación e historial</h5>
                <span class="badge text-bg-light ms-auto">@Model.SoloComentarios.Count() @(Model.SoloComentarios.Count() == 1 ? "comentario" : "comentarios")</span>
            </div>
            <div class="card-body">
                <ol class="sgei-actividad">
                    @foreach (var a in Model.Actividad)
                    {
                        if (!a.EsComentario)
                        {
                            <li class="sgei-evento">
                                <i class="bi @(a.Campo == "ALTA" ? "bi-plus-circle" : a.Campo == "ESTADO" ? "bi-arrow-left-right" : "bi-pencil")" aria-hidden="true"></i>
                                <span><strong>@a.Usuario</strong> @Evento(a)</span>
                                <time datetime="@a.Fecha.ToString("s")">@cuando(a.Fecha)</time>
                            </li>
                            continue;
                        }
                        var propio = a.UsuarioId == usuarioId;
                        <li class="sgei-mensaje@(propio ? " sgei-mensaje-propio" : "")" id="comentario-@a.Id">
                            <span class="sgei-avatar" title="@a.Usuario" aria-hidden="true">@a.Iniciales</span>
                            <div class="sgei-mensaje-burbuja">
                                <div class="sgei-mensaje-cabecera">
                                    <strong>@a.Usuario</strong>
                                    <time datetime="@a.Fecha.ToString("s")">@cuando(a.Fecha)</time>
                                    @if (a.FechaEdicion.HasValue)
                                    {
                                        <span class="text-muted" title="Editado el @cuando(a.FechaEdicion.Value)">(editado)</span>
                                    }
                                    @if (propio)
                                    {
                                        <span class="sgei-mensaje-acciones">
                                            <button type="button" class="btn btn-link btn-sm p-0" data-editar-comentario="@a.Id"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Editar</button>
                                            @using (Html.BeginForm("EliminarComentario", "Tickets", new { id = a.Id }, FormMethod.Post, new { @class = "d-inline", data_confirmar = "¿Eliminar tu comentario? No se puede deshacer." }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-link btn-sm p-0 text-danger"><i class="bi bi-trash me-1" aria-hidden="true"></i>Eliminar</button>
                                            }
                                        </span>
                                    }
                                </div>
                                <div class="sgei-html" data-texto-comentario>@Html.Raw(a.Texto)</div>
                                @if (propio)
                                {
                                    using (Html.BeginForm("EditarComentario", "Tickets", new { id = a.Id }, FormMethod.Post, new { @class = "sgei-mensaje-edicion", hidden = "hidden", data_edicion_comentario = a.Id }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <textarea name="texto" class="form-control" data-editor-alto="160" data-editor-requerido aria-label="Editar comentario">@a.Texto</textarea>
                                        <div class="d-flex justify-content-end gap-2 mt-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-cancelar-edicion>Cancelar</button>
                                            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1" aria-hidden="true"></i>Guardar</button>
                                        </div>
                                    }
                                }
                            </div>
                        </li>
                    }
                </ol>

                @using (Html.BeginForm("Comentar", "Tickets", new { id = Model.Id }, FormMethod.Post, new { @class = "sgei-comentar", id = "formulario-comentario" }))
                {
                    @Html.AntiForgeryToken()
                    <label class="form-label fw-semibold" for="texto-comentario">Agregar un comentario</label>
                    <textarea id="texto-comentario" name="texto" class="form-control" data-editor data-editor-alto="150" data-editor-requerido
                              placeholder="Contá el avance, una consulta o lo que bloquea el trabajo…">@borrador</textarea>
                    <div class="d-flex justify-content-end mt-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1" aria-hidden="true"></i>Comentar</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card sgei-ticket-lateral">
            <div class="card-body">
                <label class="form-label fw-semibold" for="estado-ticket">Estado</label>
                @if (puedeMover)
                {
                    using (Html.BeginForm("Estado", "Tickets", new { id = Model.Id }, FormMethod.Post, new { id = "formulario-estado" }))
                    {
                        @Html.AntiForgeryToken()
                        <select class="form-select sgei-estado-combo sgei-estado-combo-@Model.Estado" id="estado-ticket" name="estado" data-estado-actual="@Model.Estado">
                            @foreach (var e in EstadosTicket.Todos)
                            {
                                <option value="@e" @(e == Model.Estado ? "selected" : "")>@EstadosTicket.Nombre(e)</option>
                            }
                        </select>
                    }
                }
                else
                {
                    <div><span class="sgei-estado sgei-estado-@Model.Estado">@EstadosTicket.Nombre(Model.Estado)</span></div>
                    <div class="form-text">Solo la persona asignada o un administrador pueden cambiarlo.</div>
                }

                <dl class="sgei-ticket-datos-lista">
                    <dt>Asignado a</dt>
                    <dd><span class="sgei-avatar sgei-avatar-chico" aria-hidden="true">@Model.AsignadoIniciales</span>@Model.Asignado</dd>
                    <dt>Fecha prevista</dt>
                    <dd>@Model.FechaPrevista.ToString("dd/MM/yyyy") <span class="sgei-plazo sgei-plazo-@Model.Semaforo">@Model.TextoPlazo</span></dd>
                    <dt>Creado por</dt>
                    <dd>@Model.CreadoPor <span class="text-muted">· @cuando(Model.FechaAlta)</span></dd>
                    <dt>@(Model.Terminado ? "Duración" : "Abierto hace")</dt>
                    <dd>@Model.DiasAbierto @(Model.DiasAbierto == 1 ? "día" : "días")</dd>
                    <dt>Último cambio de estado</dt>
                    <dd>@cuando(Model.FechaEstado)</dd>
                    @if (Model.FechaFin.HasValue)
                    {
                        <dt>Terminado</dt>
                        <dd>@cuando(Model.FechaFin.Value)</dd>
                    }
                    <dt>Equipo</dt>
                    <dd>
                        @if (Model.Equipo != null)
                        {
                            <span class="text-muted">@TiposEquipo.Nombre(Model.TipoEquipo):</span> @Model.Equipo
                        }
                        else
                        {
                            <span class="text-muted">Sin equipo</span>
                        }
                    </dd>
                </dl>
            </div>
            @if (esAdmin)
            {
                <div class="card-footer d-flex justify-content-end">
                    @using (Html.BeginForm("Eliminar", "Tickets", new { id = Model.Id }, FormMethod.Post, new { data_confirmar = "¿Eliminar el ticket #" + Model.Id + " con sus comentarios e historial? No se puede deshacer." }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1" aria-hidden="true"></i>Eliminar ticket</button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section estilos {
    @Styles.Render("~/Content/summernote")
}
@section librerias {
    @Scripts.Render("~/bundles/summernote")
}
