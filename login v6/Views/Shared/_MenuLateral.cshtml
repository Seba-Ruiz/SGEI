@using login_v6.Helpers
@{
    var controlador = (string)ViewContext.RouteData.Values["controller"];
    var accion = (string)ViewContext.RouteData.Values["action"];
    var esAdmin = User.EsAdministrador();
    var equipoActual = MenuSgei.EquipoActual(controlador, accion);

    Func<ItemMenu, string> clase = item => "sgei-menu-link" + (item.EsActual(controlador, accion) ? " activo" : "");
    var usuarios = MenuSgei.Usuarios;
    var usuariosAbierto = usuarios.ContieneActual(controlador, accion);

    // Consultas: el item queda marcado también en su alta, detalle y edición (NuevoIncidente, VerInsumo, Reactivar, ...).
    var enConsultas = string.Equals(controlador, "Consultas", StringComparison.OrdinalIgnoreCase);
    Func<ItemMenu, bool> consultaActual = item => enConsultas && (
        (accion ?? "").IndexOf(item.Accion.TrimEnd('s'), StringComparison.OrdinalIgnoreCase) >= 0
        || (item.Accion == "Bajas" && string.Equals(accion, "Reactivar", StringComparison.OrdinalIgnoreCase)));
}

@* Lo propio de cada equipo (alta, preventivos, ingresos, gestión) está en la barra de su pantalla: Views/Shared/_BarraEquipo.cshtml *@
<ul class="sgei-menu">
    <li>
        <a class="@clase(MenuSgei.Dashboard)" href="@Url.Action(MenuSgei.Dashboard.Accion, MenuSgei.Dashboard.Controlador)" data-spinner>
            <i class="bi bi-speedometer2"></i> @MenuSgei.Dashboard.Texto
        </a>
    </li>
    @{ var enTickets = string.Equals(controlador, MenuSgei.Tickets.Controlador, StringComparison.OrdinalIgnoreCase); }
    <li>
        <a class="sgei-menu-link@(enTickets ? " activo" : "")" href="@Url.Action(MenuSgei.Tickets.Accion, MenuSgei.Tickets.Controlador)" data-spinner
           @(enTickets ? Html.Raw("aria-current=\"page\"") : null)>
            <i class="bi bi-kanban"></i> @MenuSgei.Tickets.Texto
        </a>
    </li>

    @* Equipos: plegable como Usuarios; queda abierto y marcado el equipo de la pantalla actual. *@
    <li>
        <button type="button" class="sgei-menu-link" data-bs-toggle="collapse" data-bs-target="#menu-equipos"
                aria-expanded="@(equipoActual != null ? "true" : "false")" aria-controls="menu-equipos">
            <i class="bi bi-hdd-stack"></i> Equipos
            <i class="bi bi-chevron-right sgei-menu-flecha"></i>
        </button>
        <div class="collapse@(equipoActual != null ? " show" : "")" id="menu-equipos">
            <ul class="sgei-submenu">
                @foreach (var equipo in MenuSgei.Equipos)
                {
                    <li>
                        <a class="sgei-menu-link@(equipo == equipoActual ? " activo" : "")" href="@Url.Action(equipo.Grilla.Accion, equipo.Grilla.Controlador)" data-spinner
                           @(equipo == equipoActual ? Html.Raw("aria-current=\"page\"") : null)>@equipo.Nombre</a>
                    </li>
                }
            </ul>
        </div>
    </li>

    @* Consultas: incidentes, insumos y bajas de todos los equipos (ConsultasController). *@
    <li>
        <button type="button" class="sgei-menu-link" data-bs-toggle="collapse" data-bs-target="#menu-consultas"
                aria-expanded="@(enConsultas ? "true" : "false")" aria-controls="menu-consultas">
            <i class="bi @MenuSgei.Consultas.Icono"></i> @MenuSgei.Consultas.Texto
            <i class="bi bi-chevron-right sgei-menu-flecha"></i>
        </button>
        <div class="collapse@(enConsultas ? " show" : "")" id="menu-consultas">
            <ul class="sgei-submenu">
                @foreach (var item in MenuSgei.Consultas.Items)
                {
                    var actual = consultaActual(item);
                    <li>
                        <a class="sgei-menu-link@(actual ? " activo" : "")" href="@Url.Action(item.Accion, item.Controlador)" data-spinner
                           @(actual ? Html.Raw("aria-current=\"page\"") : null)>@item.Texto</a>
                    </li>
                }
            </ul>
        </div>
    </li>

    @* Etiquetas: sistema aparte, se abre en otra pestaña. Dirección en Web.config (UrlEtiquetas). *@
    <li>
        <a class="sgei-menu-link" href="@(System.Configuration.ConfigurationManager.AppSettings["UrlEtiquetas"] ?? "http://etiquetas-perrupato")"
           target="_blank" rel="noopener" title="Abre el sistema de etiquetas en una pestaña nueva">
            <i class="bi bi-tags"></i> Etiquetas
            <i class="bi bi-box-arrow-up-right sgei-menu-externo" aria-hidden="true"></i>
            <span class="visually-hidden">(se abre en una pestaña nueva)</span>
        </a>
    </li>

    @if (esAdmin)
    {
        var idUsuarios = "menu-" + usuarios.Id;
        <li class="sgei-menu-titulo">Administración</li>
        <li>
            <button type="button" class="sgei-menu-link" data-bs-toggle="collapse" data-bs-target="#@idUsuarios"
                    aria-expanded="@(usuariosAbierto ? "true" : "false")" aria-controls="@idUsuarios">
                <i class="bi @usuarios.Icono"></i> @usuarios.Texto
                <i class="bi bi-chevron-right sgei-menu-flecha"></i>
            </button>
            <div class="collapse@(usuariosAbierto ? " show" : "")" id="@idUsuarios">
                <ul class="sgei-submenu">
                    @foreach (var item in usuarios.Items)
                    {
                        <li><a class="@clase(item)" href="@Url.Action(item.Accion, item.Controlador)" data-spinner>@item.Texto</a></li>
                    }
                </ul>
            </div>
        </li>
        <li>
            <a class="@clase(MenuSgei.Proveedores)" href="@Url.Action(MenuSgei.Proveedores.Accion, MenuSgei.Proveedores.Controlador)" data-spinner>
                <i class="bi bi-truck"></i> @MenuSgei.Proveedores.Texto
            </a>
        </li>
    }
</ul>
