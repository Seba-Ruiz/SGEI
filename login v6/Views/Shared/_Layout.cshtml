@using login_v6.Helpers
@{
    // Nombre y apellido del usuario conectado (o su usuario, si no tiene nombre cargado).
    var usuarioActual = UsuarioActual.Datos(User);
    var nombreUsuario = usuarioActual != null ? usuarioActual.Nombre : "";
    var inicial = usuarioActual != null ? usuarioActual.Iniciales : "?";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - SGEI</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    @Styles.Render("~/Content/css")
    @RenderSection("estilos", required: false)
</head>
<body class="sgei">
    <div id="antiforgery-ajax" hidden>@Html.AntiForgeryToken()</div>

    <div class="sgei-app">
        @* Menú lateral: fijo en pantallas grandes, panel deslizable (offcanvas) en celulares y tablets. *@
        <aside class="sgei-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="menuLateral" aria-label="Menú principal">
            <div class="d-flex align-items-center">
                <a class="sgei-marca flex-grow-1" href="@Url.Action("Index", "Inicio")" data-spinner>
                    <span class="sgei-marca-logo"><i class="bi bi-hospital"></i></span>
                    <span class="sgei-marca-texto">
                        <strong>SGEI</strong>
                        <small>Hospital Alfredo Italo Perrupato</small>
                    </span>
                </a>
                <button type="button" class="btn-close btn-close-white d-lg-none me-3" data-bs-dismiss="offcanvas"
                        data-bs-target="#menuLateral" aria-label="Cerrar menú"></button>
            </div>
            @if (Request.IsAuthenticated)
            {
                @Html.Partial("_MenuLateral")
            }
        </aside>

        <div class="sgei-main">
            <header class="sgei-topbar">
                <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral"
                        aria-controls="menuLateral" aria-label="Abrir menú">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <span class="sgei-topbar-titulo">@ViewBag.Title</span>

                @if (Request.IsAuthenticated)
                {
                    @* Campana de notificaciones (Scripts/app/notificaciones.js). *@
                    @Html.Partial("_Campana")
                    <div class="dropdown">
                        <a href="#" class="sgei-usuario dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="sgei-avatar" data-usuario-iniciales>@inicial</span>
                            <span class="d-none d-md-inline" data-usuario-nombre>@nombreUsuario</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            @* Abre la modal "Mi cuenta" (Scripts/app/mi-cuenta.js); sin JavaScript, el link lleva a Manage/Index. *@
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Manage")" data-mi-cuenta><i class="bi bi-person-circle me-2"></i>Mi cuenta</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</button>
                                }
                            </li>
                        </ul>
                    </div>
                }
            </header>

            <main class="sgei-content">
                @if (Request.IsAuthenticated)
                {
                    @* Barra del equipo (alta, consultas, ingresos, gestión) en todas sus pantallas. *@
                    @Html.Partial("_BarraEquipo")
                }
                @RenderBody()
            </main>

            <footer class="sgei-footer d-flex justify-content-between">
                <span>SGEI &middot; Sistema de Gestión de Equipos Informáticos</span>
                <span>&copy; @DateTime.Now.Year Seba Ruiz</span>
            </footer>
        </div>
    </div>

    @* Aviso de éxito de la operación anterior (toast centrado arriba) *@
    @Html.Partial("_Avisos")

    @if (Request.IsAuthenticated)
    {
        @* Modal "Mi cuenta": el contenido se pide a Manage/MiCuenta al abrirla. *@
        <div class="modal fade" id="modal-mi-cuenta" tabindex="-1" aria-labelledby="modal-mi-cuenta-titulo" aria-hidden="true"
             data-url="@Url.Action("MiCuenta", "Manage")">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content sgei-mi-cuenta" data-contenido></div>
            </div>
        </div>
    }

    @* Spinner "Espere..." al navegar (lo abre Scripts/app/sgei.js) *@
    <div id="spiner" class="modal fade sgei-spinner" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="spinner-border text-primary mx-auto mb-3" role="status"></div>
                <div class="fw-semibold">Espere...</div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/plugins")
    @Html.Script("~/Scripts/app/sgei.js")
    @if (Request.IsAuthenticated)
    {
        @* Notificaciones en vivo: SignalR + campana. *@
        @Scripts.Render("~/bundles/signalr")
        @Html.Script("~/Scripts/app/notificaciones.js")
        @Html.Script("~/Scripts/app/mi-cuenta.js")
    }
    @* Librerías que usa solo alguna pantalla (Summernote, SortableJS): antes del script de la vista. *@
    @RenderSection("librerias", required: false)
    @* Script propio de la vista: Scripts/views/<Controlador>/<vista>.js (si existe) *@
    @Html.ScriptDeVista()
    @RenderSection("scripts", required: false)
</body>
</html>
