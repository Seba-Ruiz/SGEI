@using login_v6.Models
@{
    // Se muestra después de dar de alta un usuario (AccountController.Register).
    ViewBag.Title = "Usuario creado";
}

@Html.Partial("_Resultado", new ResultadoViewModel
{
    Tipo = TipoResultado.Exito,
    Titulo = "Usuario creado",
    Mensaje = ViewBag.Message as string,
    Botones =
    {
        new BotonResultado("Ver usuarios", Url.Content("~/Usuario/Index")),
        new BotonResultado("Crear otro usuario", Url.Content("~/Account/Register"))
    }
})
