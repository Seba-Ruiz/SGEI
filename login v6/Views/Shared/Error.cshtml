@model System.Web.Mvc.HandleErrorInfo
@using login_v6.Models
@{
    ViewBag.Title = "Error";

    // ViewBag.errorMessage trae un aviso puntual (por ejemplo "Debe confirmar el correo...");
    // sin él es un error inesperado (HandleErrorAttribute).
    var aviso = ViewBag.errorMessage as string;
    var esAviso = !string.IsNullOrEmpty(aviso);
    var titulo = esAviso ? "Atención" : "Ocurrió un error";
    var texto = esAviso ? aviso : "No pudimos procesar tu solicitud. Si el problema continúa, avisale al administrador del sistema.";

    if (!Request.IsAuthenticated)
    {
        Layout = "~/Views/Shared/_LayoutCuenta.cshtml";
    }
}

@if (Request.IsAuthenticated)
{
    @Html.Partial("_Resultado", new ResultadoViewModel
    {
        Tipo = esAviso ? TipoResultado.Aviso : TipoResultado.Error,
        Titulo = titulo,
        Mensaje = texto,
        Botones =
        {
            new BotonResultado("Volver", "javascript:history.back()"),
            new BotonResultado("Ir al inicio", Url.Content("~/Inicio/Index"))
        }
    })
}
else
{
    @Html.Partial("_MensajeCuenta", new ViewDataDictionary
    {
        { "Icono", esAviso ? "bi-exclamation-triangle" : "bi-x-circle" },
        { "Color", esAviso ? "warning" : "danger" },
        { "Titulo", titulo },
        { "Texto", texto }
    })
}
