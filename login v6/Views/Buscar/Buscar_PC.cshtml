
@{
    ViewBag.Title = "Buscar_PC";
}

<h4 class="page-title">Buscar computadora</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Buscar") </li>
</ol>
@using (Html.BeginForm("BuscarNumero", "Buscar", FormMethod.Post, new { id = "frm-incidente" }))

{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-sm-8 offset-sm-2">
            <div class="card card-acento-primary">
                <div class="card-header">
                    <h4 class="card-title mb-0">BUSCAR COMPUTADORA POR NÚMERO</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                            <p class="text-muted mb-4 font-13">
                                Ingrese el número de identificación de la computadora para saber los detalles de la misma. Este número se encuentra pegado en la computadora.
                            </p>
                            <div class="mb-3 offset-lg-3">
                                @Html.Label("Numero de Computadora")
                                @Html.TextBox("numero", null,  new { @class = "form-control", @style = "width:300px;", @type="number", @required="required" })
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-primary">Buscar</button>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


}