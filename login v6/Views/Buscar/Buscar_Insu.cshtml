
@{
    ViewBag.Title = "Buscar_Insumo";
}

<h4 class="page-title">Buscar Insumo</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Buscar") </li>
</ol>
@using (Html.BeginForm("BuscarInsumoSerie", "Buscar", FormMethod.Post, new { id = "frm-incidente" }))

{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-sm-8 offset-sm-2">
            <div class="card card-acento-primary">
                <div class="card-header">
                    <h4 class="card-title mb-0">BUSCAR INSUMO POR NÚMERO DE SERIE</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                            <p class="text-muted mb-4 font-13">
                                Ingrese el número de serie del insumo para saber los detalles del mismo. 
                            </p>
                            <div class="mb-3 offset-lg-3">
                                @Html.Label("Número de serie del insumo")
                                @Html.TextBox("nro_serie", null, new { @class = "form-control", @style = "width:300px;", @required = "required" })
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-primary">Buscar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


}