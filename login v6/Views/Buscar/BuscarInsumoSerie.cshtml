@model Negocio.DTO.DTO_buscar_insumo_serie
@{
    ViewBag.Title = "Detalle";
}


<div class="container">

    <!-- Page-Title -->
    <div class="row">
        <div class="col-sm-12">

            <h4 class="page-title">Detalle del insumo</h4>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="~/Inicio/index">Inicio</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    Detalle del insumo
                </li>
            </ol>
        </div>
    </div>


    <div class="row">
        <div class="col-sm-10 offset-sm-1">
            <div class="card-box">
                <h4 class="mt-0 header-title"><b>Detalle de la Computadora Seleccionada</b></h4>
                <p class="text-muted mb-4 font-13">
                    Esta pantalla muestra la información detallada para el insumo ingresado.
                </p>

                <div class="row">
                    <div class="col-md-12">
                        <form class="" role="form">

                            <div class="mb-3">
                                <label class="col-md-2 form-label">Numero de serie del insumo</label>
                                <div class="col-md-10">

                                    <label class="form-control" readonly="">@Model.nro_serie</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="col-md-2 form-label">Nombre del insumo</label>
                                <div class="col-md-10">

                                    <label class="form-control" readonly="">@Model.nombre_insumo</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="col-md-2 form-label">Computadora donde se encuentra</label>
                                <div class="col-md-10">

                                    <label class="form-control" readonly="">@Model.nombre_equipo</label>
                                </div>
                            </div>


                            <div class="mb-3">
                                <label class="col-md-2 form-label">Número de ip de la computadora</label>
                                <div class="col-md-10">

                                    <label class="form-control" readonly="">@Model.ip_equipo</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="col-md-2 form-label">Ubicacion del insumo</label>
                                <div class="col-md-10">

                                    <label class="form-control" readonly="">@Model.ubicado_en</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="col-md-2 form-label">Fecha de colocación</label>
                                <div class="col-md-10">
                                    <label class="form-control" readonly="">@Model.fecha_colocacion</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="col-md-2 form-label">Observacion de la computadora</label>
                                <div class="col-md-10">
                                    <label class="form-control" readonly="">@Model.observacion_pc</label>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="col-md-2 form-label">Responsable</label>
                                <div class="col-md-10">
                                    <label class="form-control" readonly="">@Model.responsable</label>
                                </div>
                            </div>
                        </form>
                    </div>

                </div>

            </div>
        </div>

    </div>

</div>


