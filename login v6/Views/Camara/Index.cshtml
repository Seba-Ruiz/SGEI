
@{
    ViewBag.Title = "Camara";

}

<h4 class="page-title">Bienvenido!</h4>
<ol class="breadcrumb">

    <li class="breadcrumb-item active" aria-current="page">
        Sistema para control de insumos e incidentes de camaras
    </li>
</ol>


<div class="row">
    <div class="col-sm-6 offset-sm-3">
        <div class="card card-acento-primary">
            <div class="card-header">
                <h4 class="card-title mb-0">CAMARAS</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12">
                        @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                        <p class="text-muted mb-4 font-13">
                            Para comenzar, seleccione en el combo la ubicación de la camara, el sistema mostrará las camaras en esa ubicaciÓn.
                        </p>

                        @using (Html.BeginForm("Buscar", "Camara", FormMethod.Post, new { id = "frm-incidente" }))
                        {
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                @Html.Label("Nombre de Ubicacion:")
                                @Html.DropDownList("ubicacioncam", new SelectList(ViewBag.ubicacioncam, "id_ubicacion_camara", "nombre"), new { @class = "form-select", @style = "width:200px;" })
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-primary">Buscar</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>













