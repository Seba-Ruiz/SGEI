@model IEnumerable<Negocio.DTO.DTO_u_camara_01>
@{
    ViewBag.Title = "Buscar";
}


<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de la Consulta") </li>
</ol>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>Nº CAMARA</th>
                <th>NRO IP</th>
                <th>DESCRIPCION</th>
                <th>MODELO</th>
                <th>UBICACION</th>
                <th>FECHA UBICACION</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.id_camara</td>
                    <td><a href="http://@a.nro_ip" target=”_blank” class="text-danger">@a.nro_ip</a></td>
                    <td>@a.descripcion</td>
                    <td>@a.mmarca</td>
                    <td>@a.nombre_ubi</td>
                    <td>@a.fecha_ubicacion</td>
                    <td>
                        <div class="sgei-acciones">
                            <a class="sgei-accion" title="Editar" href="~/Camara/Editar/@a.id_detalle" aria-label="Editar"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            <a class="sgei-accion sgei-accion-aviso" data-confirmar="¿Desea agregar incidente a esta camara?" title="Cargar incidente" href="~/Camara/Incidente/@a.id_detalle" aria-label="Cargar incidente"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></a>
                            <a class="sgei-accion sgei-accion-peligro" data-confirmar="¿Desea dar de BAJA esta camara?" title="Dar de baja" href="~/Camara/Baja/@a.id_detalle" aria-label="Dar de baja"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>
