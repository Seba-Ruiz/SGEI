@model login_v6.Models.RegisterViewModel
@{
    ViewBag.Title = "Nuevo usuario";
}

<h4 class="page-title">Nuevo usuario</h4>
<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="~/Usuario/Index">Usuarios</a></li>
    <li class="breadcrumb-item active" aria-current="page">Nuevo usuario</li>
</ol>

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-5">
        <div class="card">
            <div class="card-body p-4">
                <p class="text-muted">
                    El usuario se crea con rol <strong>Operario</strong> y recibe un correo para confirmar la cuenta
                    antes de poder ingresar. El rol se puede cambiar después desde <em>Usuarios &rsaquo; Gestionar</em>.
                </p>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary("", new { @class = "alert alert-danger py-2" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, "Correo electrónico", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "email", @autocomplete = "off" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            @Html.LabelFor(m => m.Password, "Contraseña inicial", new { @class = "form-label" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-sm-6 mb-3">
                            @Html.LabelFor(m => m.ConfirmPassword, "Repetir contraseña", new { @class = "form-label" })
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", @autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="form-text mb-4">Mínimo 8 caracteres, con mayúsculas, minúsculas, números y un símbolo.</div>

                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-secondary" href="~/Usuario/Index">Cancelar</a>
                        <button class="btn btn-primary" type="submit"><i class="bi bi-person-plus me-1"></i> Crear usuario</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
