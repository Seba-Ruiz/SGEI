@model login_v6.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar contraseña";
    Layout = "~/Views/Shared/_LayoutCuenta.cshtml";
}

<h1 class="h4 fw-semibold mb-1">¿Olvidaste tu contraseña?</h1>
<p class="text-muted mb-4">Ingresá tu correo y te enviaremos un enlace para restablecerla.</p>

@using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary("", new { @class = "alert alert-danger py-2" })

    <div class="mb-4">
        @Html.LabelFor(m => m.Email, "Correo electrónico", new { @class = "form-label" })
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @type = "email", @autocomplete = "username", @autofocus = "autofocus" })
        </div>
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2">Enviar enlace</button>
}

<div class="text-center mt-4">
    @Html.ActionLink("Volver a iniciar sesión", "Login", null, new { @class = "small" })
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
