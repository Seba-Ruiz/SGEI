@model Negocio.DTO.DTO_u_computadora_detalle
@{
    ViewBag.Title = "Detalle";
}


<div class="container">

    <!-- Page-Title -->
    <div class="row">
        <div class="col-sm-12">

            <h4 class="page-title">Detalle de la Computadora</h4>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="~/Inicio/index">Dashboard</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="~/Computadora/index">Computadora</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    Detalle
                </li>
            </ol>
        </div>
    </div>
    

        <div class="row">
            <div class="col-sm-12">
                <div class="card-box">
                    <h4 class="mt-0 header-title"><b>Detalle de la Computadora Seleccionada</b></h4>
                    <p class="text-muted mb-4 font-13">
                        Esta pantalla muestra la información detallada de la computadora seleccionada. Desde aquí podrá ver y modificar el detalle de la misma. 
                    </p>

                    <div class="row">
                        <div class="col-md-6">
                            <form class="" role="form">
                                
                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Nombre de la PC</label>
                                    <div class="col-md-10">
                                        
                                        <label class="form-control" readonly="">@Model.nombre</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Número de IP</label>
                                    <div class="col-md-10">
                                       
                                        <label class="form-control" readonly="">@Model.ip</label>
                                    </div>
                                </div>


                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Descripción</label>
                                    <div class="col-md-10">
                                       
                                        <label class="form-control" readonly="">@Model.descripcion</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Ubicación</label>
                                    <div class="col-md-10">
                                        
                                        <label class="form-control" readonly="">@Model.ubicacion</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Fecha de ubicación</label>
                                    <div class="col-md-10">
                                        <label class="form-control" readonly="">@Model.fecha_ubicacion</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Responsable de la PC</label>
                                    <div class="col-md-10">
                                        <label class="form-control" readonly="">@Model.responsablepc</label>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <div class="col-md-6">
                            <form class="" role="form">
                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Observación</label>
                                    <div class="col-md-10">
                                        <label class="form-control" readonly="">@Model.observacion</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Tipo de PC</label>
                                    <div class="col-md-10">
                                        <label class="form-control" readonly="">@Model.nombre_tipo</label>
                                    </div>
                                </div>


                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Tamaño de RAM</label>
                                    <div class="col-md-10">
                                        <label class="form-control" readonly="">@Model.ram</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Tamaño de Disco</label>
                                    <div class="col-md-10">
                                        <label class="form-control" readonly="">@Model.disco</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Sistema Operativo</label>
                                    <div class="col-md-10">
                                        <label class="form-control" readonly="">@Model.so</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Procesador</label>
                                    <div class="col-md-10">
                                        <label class="form-control" readonly="">@Model.procesador</label>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="col-md-2 form-label">Placa Madre</label>
                                    <div class="col-md-10">
                                        @*@Html.DisplayFor(Model => Model.mother, new { @class = "form-control", @readonly = "" })*@
                                        <label class="form-control" readonly="">@Model.mother</label>
                                    </div>
                                </div>
                            </form>
                            @using (Html.BeginForm("EditarPC", "Computadora", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                        <div class="modal-footer">
                            <a class="btn btn-danger rounded-pill" title="Editar computadora" href="~/Computadora/EditarPC/@Model.id_detalle"> Editar </a>
                            @*<button type="submit" class="btn btn-primary">Editar</button>*@
                        </div>
                            }
                        </div>

                    </div>

                </div>
            </div>

        </div>
    
</div>


