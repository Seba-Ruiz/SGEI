@model Model.bajaPC
@{
    ViewBag.Title = "Baja";
    Model.detallepc_id = ViewBag.detalle_id;
}


<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Baja de Computadora") </li>
</ol>

@using (Html.BeginForm("BajaAceptada", "Computadora", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.detallepc_id)
    
<div class="row">
    <div class="col-sm-3"></div>
    <div class="col-sm-6">
        <div class="card card-acento-primary">
            <div class="card-header">
                <h4 class="card-title mb-0">DAR DE BAJA UNA COMPUTADORA</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-md-12">
                                <p class="text-muted mb-4 font-13">
                                    Rellene los campos que siguen para especificar el motivo de la baja.
                                </p>
                                <div class="mb-3">
                                    @Html.Label("Seleccione la ultima ubicación de la computadora.")
                                    @Html.DropDownListFor(x => x.ultima_ubicacion, new SelectList(ViewBag.ubicacion, "nombre", "nombre"), new { @class = "form-select", @style = "width:300px;" })
                                </div>

                                <div class="mb-3">
                                    @Html.Label("Seleccione el motivo de baja.")
                                    @Html.DropDownListFor(x => x.motivobaja_id, new SelectList(ViewBag.motivobaja, "id_motivobaja", "descripcion"), new { @class = "form-select", @style = "width:300px;" })
                                </div>
                            </div>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-danger">Dar de baja</button>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    
    
    
    
    
