@model Model.pc_incidentepc


@{
    ViewBag.Title = "Incidente";
    Model.pc_id = Convert.ToInt32(ViewBag.id_pc);

}


<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Home/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Cargar Incidente") </li>
</ol>

@using (Html.BeginForm("Guardarincidente", "Computadora", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.pc_id)



    <div class="row">
        <div class="col-sm-6 offset-sm-3">
            <div class="card card-acento-primary">
                <div class="card-header">
                    <h4 class="card-title mb-0">CARGA DE INCIDENTE</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                            <p class="text-muted mb-4 font-13">
                                Rellene los campos a continuación para detallar el incidente ocurrido y su acción de reparación.
                            </p>
                            <div class="mb-3">
                                @Html.Label("Seleccione el incidente ocurrido")
                                @Html.DropDownList("incidentepc", new SelectList(ViewBag.incidentepc, "id_incidentepc", "nombre"), new { @class = "form-select", @style = "width:500px;" })
                            </div>

                            <div class="mb-3">
                                @Html.Label("Fecha de Incidente")
                                @Html.TextBoxFor(x => x.fecha_incidente, new { @class = "form-control", type = "date", @style = "width:200px;" })
                                @Html.ValidationMessageFor(x => x.fecha_incidente, null, new { @class = "text-danger small" })
                            </div>

                            <div class="mb-3">
                                @Html.Label("Accion Realizada")
                                @Html.TextBoxFor(x => x.reparacion, new { @class = "form-control", @style = "width:500px;", @required = "required" })
                                @Html.ValidationMessageFor(x => x.reparacion, null, new { @class = "text-danger small" })
                            </div>

                            <div class="mb-3">
                                @Html.Label("Fecha de AcciÓn Realizada")
                                @Html.TextBoxFor(x => x.fecha_reparacion, new { @class = "form-control", type = "date", @style = "width:200px;" })
                                @Html.ValidationMessageFor(x => x.fecha_reparacion, null, new { @class = "text-danger small" })
                            </div>

                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="modal fade" id="mostrarmodal" tabindex="-1" role="dialog" aria-labelledby="basicModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    <h3>Atención</h3>
                </div>
                <div class="modal-body">
                    <h4>Desea agregar el incidente?</h4>
                    Al aceptar se agregara el incidente a la computadora. Luego podrá consultar el incidente dentro del menu consultas.
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Aceptar</button>
                    @*<a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Aceptar</a>*@
                </div>
            </div>
        </div>
    </div>
}

@*<div class="text-center">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#mostrarmodal">Agregar</button>
</div>*@
<div class="text-center">
    <button class="btn btn-primary"  data-bs-toggle="modal" data-bs-target="#mostrarmodal">Agregar</button>
</div>


@**@





