@model IEnumerable<Negocio.DTO.DTO_preventivo_pc>

@{
    ViewBag.Title = "Preventivo";
}


<div class="row">
    <div class="col-sm-12">
        <div class="card-box">
            <h4 class="mt-0 header-title text-primary"><b>MANTENIMIENTO PREVENTIVO DE COMPUTADORAS</b></h4>
            <p class="text-muted font-13 mb-4">
                La lista muestra los mantenimientos realizados a las <code>COMPUTADORAS</code>. Podrás filtrar la lista mediante el campo buscar.
            </p>

            <table class="table table-hover sgei-grilla" data-grilla>
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Fecha Mantenimiento</th>
                        <th>Pospuesto por</th>
                        <th>Fecha Pospuso</th>
                        <th>Realizado por</th>
                        <th class="sgei-col-acciones">Acciones</th>
                    </tr>
                </thead>


                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td><span class="text-dark"><b>@item.nombre</b></span></td>
                            <td><span class="text-dark">@item.proximo_mantenimiento</span></td>

                            @if (item.pospuesto_por != null)
                            {
                                <td><span class="text-dark">@item.pospuesto_por</span></td>
                            }
                            else
                            {
                                <td><span class="text-dark">-----</span></td>
                            }
                            @if (@item.fecha_pospuso != null)
                            {
                                <td><span class="text-dark">@item.fecha_pospuso</span></td>
                            }
                            else
                            {
                                <td><span class="text-dark">-----</span></td>
                            }
                            @if (@item.realizado_por != null)
                            {
                                <td><span class="text-dark">@item.realizado_por</span></td>
                            }
                            else
                            {
                                <td><span class="text-dark">A realizarse</span></td>
                            }

                            <td>
                                <div class="sgei-acciones">
                                    <a class="js-ver-descripcion sgei-accion sgei-accion-info" href="#" data-descripcion="@item.descripcion" title="Descripción" aria-label="Descripción"><i class="bi bi-file-text" aria-hidden="true"></i></a>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="descripcion" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Descripción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3 text-muted">
            Se muestra la descripción de lo que se le realizó durante el mantenimiento a la computadora.

            <div class="mt-2">
                <label id="descri"></label>
            </div>
        </div>
            </div>
            <div class="modal-footer">
                <a href="#" data-bs-dismiss="modal" class="btn btn-outline-secondary">Cerrar</a>
            </div>
        </div>
    </div>
</div>





