@model IEnumerable<Negocio.DTO.DTO_u_computadora>
@{
    ViewBag.Title = "Computadoras";
}

<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Dashboard</a></li>
    <li class="breadcrumb-item active" aria-current="page">Computadoras</li>
</ol>

<div class="card-box">
    @* Combo de ubicación: Scripts/app/sgei.js lo ubica junto al buscador y filtra la columna Ubicación (data-filtro-grilla). *@
    <div class="sgei-grilla-filtro">
        <label class="visually-hidden" for="ubicacion">Ubicación</label>
        @Html.DropDownList("ubicacion", (SelectList)ViewBag.ubicaciones, "Todas las ubicaciones", new { @class = "form-select", autocomplete = "off", data_filtro_grilla = "#grilla-computadoras", data_filtro_columna = ".sgei-col-ubicacion", data_buscable = "" })
    </div>

    <table class="table table-hover sgei-grilla" data-grilla id="grilla-computadoras">
        <thead>
            <tr>
                <th>Nº PC</th>
                <th>NOMBRE PC</th>
                <th>Nº IP</th>
                <th class="sgei-col-ubicacion">UBICACIÓN</th>
                <th>DESCRIPCION</th>
                <th class="sgei-col-fecha-ubicacion">FECHA UBICACION</th>
                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
            <tr>
                <td>@a.id_pc</td>
                <td>@a.nombre</td>
                <td>@a.ip</td>
                <td>@a.ubicacion</td>
                <td>@a.descripcion</td>
                <td>@a.fecha_ubicacion</td>
                <td>
                    <div class="sgei-acciones">
                        <a class="sgei-accion sgei-accion-info" title="Detalle de la computadora" href="~/Computadora/Detalle/@a.id_detalle" aria-label="Detalle de la computadora"><i class="bi bi-eye" aria-hidden="true"></i></a>
                        <button type="button" class="sgei-accion sgei-accion-neutro" data-mover-ubicacion data-id="@a.id_detalle" data-nombre="@a.nombre" data-ubicacion="@a.ubicacion" title="Mover a otra ubicación" aria-label="Mover de ubicación la PC @a.nombre"><i class="bi bi-arrows-move" aria-hidden="true"></i></button>
                        <a class="sgei-accion sgei-accion-peligro" data-confirmar="¿Desea dar de BAJA esta computadora?" title="Dar de baja a la PC" href="~/Computadora/Baja/@a.id_detalle" aria-label="Dar de baja a la PC"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i></a>
                    </div>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

@* Modal para mover de ubicación (Scripts/app/mover-ubicacion.js), con las ubicaciones de computadoras. *@
@Html.Partial("_MoverUbicacion", (SelectList)ViewBag.ubicaciones, new ViewDataDictionary { { "url", Url.Action("MoverUbicacion", "Computadora") }, { "equipo", "computadora" } })

@section scripts {
    @Html.Script("~/Scripts/app/mover-ubicacion.js")
}
