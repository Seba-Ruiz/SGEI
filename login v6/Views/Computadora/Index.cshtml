
@{
    ViewBag.Title = "Computadora";

}

<h4 class="page-title">Bienvenido!</h4>
<ol class="breadcrumb">

    <li class="breadcrumb-item active" aria-current="page">
        Sistema para la gestión de las computadoras en el hospital.
    </li>
</ol>


<div class="row">
    <div class="col-sm-6 offset-sm-3">
        <div class="card card-acento-primary">
            <div class="card-header">
                <h4 class="card-title mb-0">COMPUTADORAS</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-12">
                        @*<h5><b>INSUMOS POR FECHA</b></h5>*@
                        <p class="text-muted mb-4 font-13">
                            Para comenzar, seleccione en el combo la ubicación de la computadora, el sistema mostrará las computadoras en esa ubicación.
                        </p>
                        @using (Html.BeginForm("Buscar", "Computadora", FormMethod.Post, new { id = "frm-incidente" }))
                        {
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                @Html.Label("Nombre de Ubicacion:")
                                @Html.DropDownList("ubicacionpc", new SelectList(ViewBag.ubicacionpc, "id_ubicacion", "nombre"), new { @class = "form-select", @style = "width:200px;" })
                            </div>
                            <div class="mb-3">
                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary">Buscar</button>
                                </div>
                            </div>
                            foreach (var item in @ViewBag.insu)
                            {
                                if (item.cantidad == 0)
                                {
                                    <div class="alert alert-danger" role="alert">
                                        <strong>ATENCIÓN</strong> Sin stock disponible para el insumo @item.nombre
                                    </div>
                                }

                                if (item.cantidad < 5 & item.cantidad > 0)
                                {
                                    <div class="alert alert-info" role="alert">
                                        <strong>ATENCIÓN</strong> Quedan @item.cantidad insumos @item.nombre
                                    </div>
                                }
                            }

                        }


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
