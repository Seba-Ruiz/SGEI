@model IEnumerable<Negocio.DTO.DTO_u_computadora>
@{
    ViewBag.Title = "Buscar";
}


<ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="~/Inicio/Index">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">@("Detalle de la Consulta") </li>
</ol>

<div class="card-box">
    <table class="table table-hover sgei-grilla" data-grilla>
        <thead>
            <tr>
                <th>Nº PC</th>
                <th>NOMBRE PC</th>
                <th>Nº IP</th>
                <th>DESCRIPCION</th>
                <th>FECHA UBICACION</th>

                <th class="sgei-col-acciones">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
            <tr>
                <td>@a.id_pc</td>
                <td>@a.nombre</td>
                <td>@a.ip</td>
                <td>@a.descripcion</td>
                <td>@a.fecha_ubicacion</td>
                <td>
                    <div class="sgei-acciones">
                        <a class="sgei-accion sgei-accion-info" title="Detalle de la computadora" href="~/Computadora/Detalle/@a.id_detalle" aria-label="Detalle de la computadora"><i class="bi bi-eye" aria-hidden="true"></i></a>
                        <a class="sgei-accion sgei-accion-neutro" title="Agregar Insumo" href="~/Insumo/AgregarInsumoPC/@a.id_detalle" aria-label="Agregar Insumo"><i class="bi bi-box-seam" aria-hidden="true"></i></a>
                        <a class="sgei-accion sgei-accion-aviso" data-confirmar="¿Desea agregar incidente a esta computadora?" title="Cargar incidente" href="~/Computadora/Incidente/@a.id_detalle" aria-label="Cargar incidente"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></a>
                        <a class="sgei-accion sgei-accion-neutro" data-confirmar="¿Desea mover de ubicación esta computadora?" title="Mover a otra ubicacion la PC" href="~/Computadora/BuscarParaMover/@a.id_detalle" aria-label="Mover a otra ubicacion la PC"><i class="bi bi-arrows-move" aria-hidden="true"></i></a>
                        <a class="sgei-accion sgei-accion-peligro" data-confirmar="¿Desea dar de BAJA esta computadora?" title="Dar de baja a la PC" href="~/Computadora/Baja/@a.id_detalle" aria-label="Dar de baja a la PC"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i></a>
                    </div>
                </td>
            </tr>
            }
        </tbody>

    </table>
</div>
