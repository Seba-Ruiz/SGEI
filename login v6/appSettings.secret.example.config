<?xml version="1.0" encoding="utf-8"?>
<!--
  Copiar este archivo como "appSettings.secret.config" (mismo directorio que Web.config)
  y completar los datos reales. appSettings.secret.config está en .gitignore y NO se versiona.
  Para Gmail hay que usar una "contraseña de aplicación" (la contraseña normal de la cuenta no funciona).
-->
<appSettings>
  <add key="Smtp:Host" value="smtp.gmail.com" />
  <add key="Smtp:Puerto" value="587" />
  <add key="Smtp:Usuario" value="informatica.perrupato@gmail.com" />
  <add key="Smtp:Password" value="ldzd vbve mava ucch" />
  <add key="Smtp:Remitente" value="informatica.perrupato@gmail.com" />
  <!-- Nombre que ve quien recibe los mails (por defecto "SGEI"). -->
  <add key="Smtp:NombreRemitente" value="SGEI - Hospital Perrupato" />
  <!-- Opcional: dirección del sistema para los links de los mails, solo protocolo y servidor. -->
  <!-- <add key="UrlSistema" value="http://192.168.10.198" /> -->
</appSettings>
