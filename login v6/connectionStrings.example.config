<?xml version="1.0" encoding="utf-8"?>
<!--
  Copiar este archivo como "connectionStrings.config" (mismo directorio que Web.config)
  y completar los datos reales. connectionStrings.config está en .gitignore y NO se versiona.
  En el servidor IIS el archivo debe existir junto al Web.config publicado.
-->
<connectionStrings>
  <add name="SGEIContext"
       connectionString="data source=SERVIDOR\INSTANCIA;initial catalog=SGEI_HP;persist security info=False;user id=USUARIO;password=CONTRASEÑA;multipleactiveresultsets=False;connect timeout=30;encrypt=True;trustservercertificate=True;application name=SGEI"
       providerName="System.Data.SqlClient" />
</connectionStrings>
